    skos:definition "Pulsed radiofrequency signal in NMR that rotates the bulk magnetization vector (\\(\\boldsymbol{M}_{0}\\)) of a nuclear spin to its opposing direction, effectively inverting the signal, (e.g., from the \\(+z\\) to \\(-z\\) axis)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "180° pulse"@en ;
