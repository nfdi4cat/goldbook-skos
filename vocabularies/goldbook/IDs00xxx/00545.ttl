PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX goldbook: <https://w3id.org/goldbook/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

goldbook:00545
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00545"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00545.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00545.ttl> ;
    skos:definition "An equation, describing crystallization kinetics, of the form: \\[1 - \\varphi _{c} = \\rm{e}^{K\\ t^{n}}\\] where \\(\\varphi _{c}\\) is the crystalline volume fraction developed at time \\(t\\) and constant temperature, \\(K\\) and \\(n\\) are suitable parameters. \\(K\\) is temperature dependent. According to the original theory, \\(n\\) should be an integer from 1 to 4, the value of which should depend only on the type of the statistical model; however, it has become customary to regard it as an adjustable parameter that may be non-integral."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "Avrami equation"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00545> ;
.
