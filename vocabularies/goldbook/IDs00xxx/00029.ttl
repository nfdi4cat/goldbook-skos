goldbook:00029
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00029"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00029.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00029.ttl> ;
    skos:definition "A procedure where the concentration of a known analyte may be determined by diluting the sample with solvent until the absorbance matches the absorbance of the analyte in the reference cell. This method is particularly useful if the Beer-Lambert law does not hold."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "absorbance matching"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00029> ;
