PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

goldbook:00512
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00512"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00512.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00512.ttl> ;
    skos:definition "A transformation by which one molecular entity (the substrate) is converted into another by the formation of one (and only one) two-centre bond between the substrate and another molecular entity and which involves no other changes in connectivity in the substrate. For example, the formation of an acyl cation by attachment of carbon monoxide to a carbenium ion ($\\ce{R^{+}}$):  The product of an attachment may also be the adduct of the two reactants, but not all adducts can be represented as the products of an attachment. (For example, the Diels–Alder cycloaddition:  results in an adduct of buta-1,3-diene and ethene, but the reaction cannot be described as an attachment since bonds are formed between more than two centres.)"@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "attachment"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00512> ;
.
