goldbook:00187
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00187"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00187.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00187.ttl> ;
    skos:definition "The term designates structures in which a hydrogen atom is bonded to both a carbon atom and a metal atom. The term is also used to characterize the interaction between a $\\ce{CH}$ bond and an unsaturated metal centre, and to describe similar bonding of a transition metal with $\\ce{Si–H}$ compounds. The expression '$\\mu$-hydrido-bridged' is also used to describe the bridging hydrogen."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "agostic"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00187> ;
.
