goldbook:00302
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00302"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00302.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00302.ttl> ;
    skos:definition "The property of surface activity is usually due to the fact that the molecules of the substance are amphipathic or amphiphilic, meaning that each contains both a hydrophilic and a hydrophobic (lipophilic) group. This assumes that one of the two phases is aqueous, and the other non-aqueous. If both are non-aqueous (e.g. oil/air), molecules containing organophilic and organophobic groups may be amphipathic and surface active."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amphipathic"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00302> ;
.
