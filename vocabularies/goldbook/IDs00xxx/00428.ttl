goldbook:00428
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00428"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00428.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00428.ttl> ;
    skos:definition "A sedimentation method based on the fact that at the meniscus and at the bottom of the centrifuge cell there is never a flux of the solute across a plane perpendicular to the radial direction and the equations characterizing the sedimentation equilibrium always apply there, even though the system as a whole may be far from equilibrium. The use of the term 'approach to sedimentation equilibrium' for Archibald's method is discouraged, since it has a more general meaning."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "Archibald's method"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00428> ;
.
