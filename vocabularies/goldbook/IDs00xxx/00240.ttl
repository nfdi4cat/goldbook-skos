goldbook:00240
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00240"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00240.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00240.ttl> ;
    skos:definition "Enzymes which contain regions to which small, regulatory molecules (cf. effector) may bind in addition to and separate from substrate binding sites. On binding the effector, the catalytic activity of the enzyme towards the substrate may be enhanced, in which case the effector is an activator, or reduced, in which case it is an inhibitor."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "allosteric enzymes"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00240> ;
.
