goldbook:00510
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00510"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00510.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00510.ttl> ;
    skos:definition "A mechanism that sometimes applies to the combination of atoms, but rarely of free radicals. In this mechanism the atom A first combines with a third body or chaperon, $$\\ce{A + M -> AM}$$ and the complex AM then forms $\\ce{A2 + M}$ by collision with another atom $\\ce{A}$. Contrast the energy-transfer mechanism."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "atom–molecule complex mechanism"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00510> ;
.
