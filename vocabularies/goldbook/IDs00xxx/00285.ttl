    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00285.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00285.ttl> ;
    skos:altLabel
        "aminooxyl radicals"@en ,
        "iminooxy radicals"@en ;
    skos:definition "Compounds having the structure $\\ce{R2N–O^{.}  R2N^{.+}–O^{−}}$; they are radicals derived from hydroxylamines by removal of the hydrogen atom from the hydroxy group, and are in many cases isolable. The synonymous terms 'nitroxyl radicals' and 'nitroxides' erroneously suggest the presence of a nitro group; their use is not desirable. Example, $\\ce{(ClCH2)2N–O^{.}}$ bis(chloromethyl)aminoxyl."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "aminoxyl radicals"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00285> ;
.
