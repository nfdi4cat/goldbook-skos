    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00198.ttl> ;
    skos:definition "One of the quantifiable properties relating to an air sample: concentration of a constituent, wind speed, temperature, etc. The quantity of air quality characteristic is the true value of the characteristic being investigated; it is recognized that in practice, this value can only be approximated by existing methods."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "air quality characteristic"@en ;
