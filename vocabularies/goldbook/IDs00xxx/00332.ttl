goldbook:00332
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00332"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00332.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00332.ttl> ;
    skos:definition "A function which relates the measured value \\(\\hat{C}_{\\rm{a}}\\) to the instrument reading, \\(X\\), with the value of all interferants, \\(C_{i}\\), remaining constant. This function is expressed by the following regression of the calibration results. \\[\\hat{C}_{\\rm{a}} = f\\left(X\\right)\\] The analytical function is taken as equal to the inverse of the calibration function."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "analytical function"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00332> ;
.
