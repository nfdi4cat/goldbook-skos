    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00247.ttl> ;
    skos:definition "A substitution reaction occurring at position 1/ of an allylic system, the double bond being between positions 2/ and 3/. The incoming group may be attached to the same atom 1/ as the leaving group, or the incoming group becomes attached at the relative position 3/, with movement of the double bond from 2/3 to 1/2. For example:  (written as a transformation)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "allylic substitution reaction"@en ;
    skos:topConceptOf goldbook: ;
