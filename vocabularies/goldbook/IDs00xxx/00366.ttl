    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00366.ttl> ;
    skos:altLabel "energy pooling"@en ;
    skos:definition """1. An interaction between a particle and its antiparticle in which they both disappear.
2. Two atoms or molecular entities both in an excited electronic state interact often (usually upon collision) to produce one atom or molecular entity in an excited electronic state and another in its ground electronic state. This phenomenon (annihilation) is sometimes referred to as 'energy pooling'."""@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "annihilation"@en ;
    skos:topConceptOf goldbook: ;
