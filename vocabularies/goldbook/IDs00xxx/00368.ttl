    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00368.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00368.ttl> ;
    skos:definition "Mancude monocyclic hydrocarbons without side chains of the general formula $\\ce{C_{n}H_{n}}$ ($n$ is an even number) or $\\ce{C_{n}H_{n+1}}$ ($n$ is an odd number). In systematic nomenclature an annulene with seven or more carbon atoms may be named [$n$]annulene, where $n$ is the number of carbon atoms, e.g. annulene for cyclonona-1,3,5,7-tetraene."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "annulenes"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00368> ;
.
