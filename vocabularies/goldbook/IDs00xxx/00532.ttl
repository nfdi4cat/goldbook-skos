goldbook:00532
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00532"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00532.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00532.ttl> ;
    skos:definition "The product of the activities (or, more approximately, concentrations) of the species produced as the result of autoprotolysis. For solvents in which no other ionization processes are significant the term is synonymous with 'ionic product'. The autoprotolysis constant for water, \\(K_{\\rm{w}}\\), is equal to the product of activities: \\[a\\left(\\rm{H}_{3}\\rm{O}^{\\rm{+}}\\right)\\ a\\left(\\rm{OH}^{\\rm{-}}\\right) = 1.0\\times 10^{-14}\\] at \\(25\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "autoprotolysis constant"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00532> ;
.
