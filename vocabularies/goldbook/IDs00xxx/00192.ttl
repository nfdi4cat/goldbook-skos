goldbook:00192
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00192"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00192.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00192.ttl> ;
    skos:definition "A qualitative term to describe a widespread body of air with approximately uniform characteristics which had been identified at a given time over a particular region of the earth's surface. Sometimes an air mass is marked by inert tracers such as $\\ce{SF6}$ which may be added to it. The composition of a given air mass undergoes alteration as it migrates, chemical changes occur, compounds are removed by dry and wet deposition and new impurities are added to the mass."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "air mass"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00192> ;
.
