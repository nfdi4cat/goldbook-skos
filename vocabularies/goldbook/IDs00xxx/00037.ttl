goldbook:00037
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00037"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00037.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00037.ttl> ;
    skos:definition "Linear decadic (\\(a\\),\\(K\\)) and Napierian absorption coefficients (\\(\\alpha \\)) are equal to the corresponding absorbances divided by the optical path length through the sample. The molar absorption coefficients (decadic \\(\\varepsilon\\), Napierian \\(\\kappa \\)) are the linear absorption coefficients divided by the amount concentration."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "absorption coefficient"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00037> ;
.
