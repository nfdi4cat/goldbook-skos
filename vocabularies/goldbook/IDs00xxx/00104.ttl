goldbook:00104
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00104"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00104.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00104.ttl> ;
    skos:definition "A substance, other than the catalyst or one of the substrates, that increases the rate of a catalysed reaction without itself being consumed; the process is called activation. An activator of an enzyme-catalysed reaction may be called enzyme activator, if it acts by binding to the enzyme."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "activator"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00104> ;
