goldbook:00057
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00057"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00057.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00057.ttl> ;
    skos:definition "A measure of the efficiency of capture of molecules or atoms which collide with aerosol particles, cloud droplets, etc. The accommodation coefficient is the fraction of the collisions which result in the capture of the molecules (atoms, radicals, etc.) by the particle, cloud droplet, etc.; fraction of colliding molecules which are not reflected but which enter the surface of an aqueous aerosol. Synonymous with sticking coefficient."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "accommodation coefficient"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00057> ;
.
