    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00200.ttl> ;
    skos:definition "A number of air sampling stations which are established in a given geographical region at which measurements of both pollutant concentrations and meteorological quantities (wind speed, direction, rain fall, humidity, etc.) are made to determine the extent and the nature of the air pollution and to establish trends in the concentrations of the air pollutants with time."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "air sampling network"@en ;
