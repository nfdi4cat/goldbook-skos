    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs13xxx/13993.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs13xxx/13993.ttl> ;
    skos:definition "Photocatalytic production of substances from simple compounds (e.g., \\(\\ce{H2}\\) and \\(\\ce{O2}\\) from water, \\(\\ce{H2}\\) from hydrogen sulfide, etc.) using ultraviolet, visible, or infrared radiation absorbed by chromophoric systems, often included in microheterogeneous media, mimicking the action of antennae and reaction centres in natural photosynthetic organisms."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "artificial photosynthesis"@en ;
