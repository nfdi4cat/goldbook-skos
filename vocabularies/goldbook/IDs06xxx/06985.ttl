goldbook:06985
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "06985"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs06xxx/06985.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs06xxx/06985.ttl> ;
    skos:definition "A topological property of the molecular graphs of alternant hydrocarbons which allows the carbon atoms to be divided into two subsets in such a way that no two atoms of the same subset are adjacent. A consequence of this property is the symmetrical arrangement of the energy levels of bonding and antibonding Hückel MOs relative to the level of a nonbonding orbital (energy level of the p AO of a carbon atom)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alternancy symmetry"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.AT06985> ;
.
