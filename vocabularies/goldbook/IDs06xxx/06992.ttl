    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs06xxx/06992.ttl> ;
    skos:definition "A quantity used in perturbation HMO theory as a measure of the change in electron density, \\(q\\), of atom \\(s\\) caused by a change in the electronegativity (or coulomb integral) of atom \\(r\\): \\[\\pi _{\\rm{sr}}=\\frac{\\partial q_{\\rm{s}}}{\\partial a_{\\rm{r}}}\\]"@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "atom-atom polarizability"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.AT06992> ;
.
