PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

goldbook:15455
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "15455"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs15xxx/15455.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs15xxx/15455.ttl> ;
    skos:definition "Regular and systematic pattern of growth such that the mass or size of any organ or part of a body can be expressed in relation to the total mass or size of the entire organism according to the allometric equation: \\[Y = b{x^{\\alpha}}\\] where \\(Y\\) = mass of the organ, \\(x\\) = mass of the organism, \\(\\alpha\\) = growth coefficient of the organ, and \\(b\\) is a constant."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "allometric growth"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.15455> ;
.
