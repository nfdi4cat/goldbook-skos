    skos:altLabel "ascending development"@en ;
    skos:definition "A mode of operation in which the paper or plate is in a vertical or slanted position and the mobile phase is supplied to its lower edge; the upward movement depends on capillary action."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "ascending elution"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00466> ;
.

goldbook:00467
    a skos:Concept ;
