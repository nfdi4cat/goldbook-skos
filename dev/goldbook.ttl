    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00077.ttl> ;
    skos:definition "The acids deposited by transfer from the atmosphere either by precipitation (rain, fog, snow, etc.), called wet deposition, or by direct transfer to the surface of the earth induced by the flow of acid-containing air masses over the earth's surface, called dry deposition."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "acid deposition"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00077> ;
.

goldbook:00079
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00079"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00079.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00079.ttl> ;
    skos:definition "Of a compound: For Brønsted acids the tendency of a compound to act as a hydron donor. It can be quantitatively expressed by the acid dissociation constant of the compound in water or some other specified medium. For Lewis acids it relates to the association constants of Lewis adducts and π adducts.Of a medium: The use of the term is mainly restricted to a medium containing Brønsted acids, where it means the tendency of the medium to hydronate a specific reference base. It is quantitatively expressed by the appropriate acidity function."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "acidity"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00079> ;
.

goldbook:00080
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00080"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00080.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00080.ttl> ;
    skos:definition "The equilibrium constant \\(K_{\\rm{a}n}\\) for splitting off the nth proton from a charged or uncharged acid, to be defined. One may write \\(K_{\\rm{a}}\\) for \\(K_{\\rm{a}1}\\)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "acidity constant"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00080> ;
.

goldbook:00081
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00081"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00081.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00081.ttl> ;
    skos:definition "Any function that measures the thermodynamic hydron-donating or -accepting ability of a solvent system, or a closely related thermodynamic property, such as the tendency of the lyate ion of the solvent system to form Lewis adduct. (The term 'basicity function' is not in common use in connection with basic solutions.) Acidity functions are not unique properties of the solvent system alone, but depend on the solute (or family of closely related solutes) with respect to which the thermodynamic tendency is measured. Commonly used acidity functions refer to concentrated acidic or basic solutions. Acidity functions are usually established over a range of composition of such a system by UV/VIS spectrophotometric or NMR measurements of the degree of hydronation (protonation or Lewis adduct formation) for the members of a series of structurally similar indicator bases (or acids) of different strength: the best known of these functions is the Hammett acidity function \\(H_{0}\\) (for uncharged indicator bases that are primary aromatic amines)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "acidity function"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00081> ;
.

goldbook:00082
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00082"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00082.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00082.ttl> ;
    skos:definition "Pathological condition in which the hydrogen ion substance concentration of body fluids is above normal and hence the pH of blood falls below the reference interval."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "acidosis"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00082> ;
.

goldbook:00083
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00083"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00083.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00083.ttl> ;
    skos:definition "Rain with \\(\\rm{pH}\\) values &lt; about 5; commonly results from acids formed from pollutants. 'Pure' rain water equilibrated with atmospheric $\\ce{CO2}$ and naturally occurring acids in relatively clean air usually has a \\(\\rm{pH} > 5\\)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "acid rain"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00083> ;
.

goldbook:00085
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00085"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-06"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00085.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00085.ttl> ;
    skos:definition "A class name for hydrocarbylideneazinic acids, $\\ce{R2C=N^{+}(–O^{−})OH}$. The use of aci-nitro as a prefix in systematic nomenclature to name specific compounds is abandoned."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "aci-nitro compounds"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00085> ;
.

goldbook:00087
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00087"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00087.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00087.ttl> ;
    skos:definition "A chemical system or physical device which determines the number of photons in a beam integrally or per unit time. This name is commonly applied to devices used in the ultraviolet and visible wavelength ranges. For example, solutions of iron(III) oxalate can be used as a chemical actinometer, while bolometers, thermopiles, and photodiodes are physical devices giving a reading that can be correlated to the number of photons detected."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "actinometer"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00087> ;
.

goldbook:00089
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00089"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00089.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00089.ttl> ;
    skos:definition "If the temperature coefficient of the rate of adsorption is substantial, an adsorption process is said to be activated (i.e. to have a significant activation energy). In this case, the sticking coefficient is small. In general, the activation energy of activated adsorption is a function of coverage and it usually increases with increasing coverage."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "activated adsorption process"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00089> ;
.

goldbook:00090
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00090"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00090.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00090.ttl> ;
    skos:definition "A porous carbon material, a char which has been subjected to reaction with gases, sometimes with the addition of chemicals, e.g. $\\ce{ZnCl2}$, before, during or after carbonization in order to increase its adsorptive properties."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "activated carbon"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00090> ;
.

goldbook:00091
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00091"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00091.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00091.ttl> ;
    skos:definition "A traditional term for activated carbon."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "activated charcoal"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00091> ;
.

goldbook:00092
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00092"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00092.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00092.ttl> ;
    skos:definition "An activated complex, often characterized by the superscript ‡, is defined as that assembly of atoms which corresponds to an arbitrary infinitesimally small region at or near the col (saddle point) of a potential energy surface."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "activated complex"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00092> ;
.

goldbook:00093
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00093"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00093.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00093.ttl> ;
    skos:definition "This word is used in different senses:   Input of external energy into a chemical system is said to bring about activation of the system.   An added substance that increases the rate of a catalysed reaction is known as an activator, and the effect is called activation. The degree of activation \\(\\varepsilon_{\\rm{a}}\\) is defined by: \\[\\varepsilon_{\\rm{a}}=\\frac{v\\,-\\,v_{0}}{v_{0}} = \\frac{v}{v_{0}} - 1\\] where \\(v_{0}\\) is the rate of the catalysed reaction in the absence of the activator and \\(v\\) is the rate of the catalysed reaction in the presence of the activator.  When some of the energy required for a reaction to occur is provided by a previous exothermic chemical reaction there is said to be chemical activation."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "activation"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00093> ;
.

goldbook:00094
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00094"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00094.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00094.ttl> ;
    skos:definition "The process of transition from the passive to the active state by removal of the passivating film. A necessary condition for activation is an electrode potential negative to the equilibrium potential of formation of the passivating film. Activation is achieved by cathodic currents, by a reduced substance in the adjacent solution, or by contact with an electronic conductor having a suitably negative corrosion potential."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "activation"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00094> ;
.

goldbook:00095
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00095"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00095.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00095.ttl> ;
    skos:definition "The process of inducing radioactivity by irradiation. In general, a specification is added of the type of incident radiation (e.g. nuclear, neutron, photon) or its energy (e.g. thermal, fast)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "activation"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00095> ;
.

goldbook:00096
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00096"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00096.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00096.ttl> ;
    skos:altLabel "nuclear activation analysis"@en ;
    skos:definition "A kind of elemental or isotopic analysis based on the measurement of characteristic radiation from nuclides formed directly or indirectly by activation of the test portion. In general, a specification is added of the type of the incident radiation (e.g. neutron, photon) and its energy (e.g. thermal, fast)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "activation analysis"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00096> ;
.

goldbook:00101
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00101"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00101.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00101.ttl> ;
    skos:definition "The cross-section for the formation of a radionuclide by a specified reaction."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "activation cross-section"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00101> ;
.

goldbook:00104
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00104"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00104.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00104.ttl> ;
    skos:definition "A substance, other than the catalyst or one of the substrates, that increases the rate of a catalysed reaction without itself being consumed; the process is called activation. An activator of an enzyme-catalysed reaction may be called enzyme activator, if it acts by binding to the enzyme."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "activator"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00104> ;
.

goldbook:00109
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00109"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00109.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00109.ttl> ;
    skos:definition "A porous solid with adsorptive properties by means of which chromatographic separations may be achieved. The separations resulting from this action follow laws different from those deriving from the partitioning action of the liquid phase."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "active solid"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00109> ;
.

goldbook:00111
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00111"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00111.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00111.ttl> ;
    skos:definition "Corrosion in the active state occurs by direct transfer (which may involve one or several steps) of metal ions from the metallic phase to the adjacent electrolyte. The corrosion current of an active metal usually increases when the electrode potential is made more positive, other conditions remaining constant."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "active state"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00111> ;
.

goldbook:00112
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00112"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00112.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00112.ttl> ;
    skos:definition "The carriage of a solute across a biological membrane from low to high concentration which requires the expenditure of (metabolic) energy."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "active transport"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00112> ;
.

goldbook:00119
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00119"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00119.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00119.ttl> ;
    skos:definition "Diesters of geminal diols; i.e.  E.g. benzylidene diacetate:"@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "acylals"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00119> ;
.

goldbook:00126
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
