    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00497.ttl> ;
    skos:definition "One twelfth of the mass of a carbon-12 atom in its nuclear and electronic ground state, \\(m_{\\rm{u}} = \\pu{1.6605402(10)E-27 kg}\\). It is equal to the unified atomic mass unit."@en ;
