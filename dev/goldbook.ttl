    skos:definition "A molecular species of gas, dissolved substance or liquid which adheres to or is adsorbed in an extremely thin surface layer of a solid substance."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "adsorbate"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00152> ;
