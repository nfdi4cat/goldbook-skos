    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00041.ttl> ;
    skos:definition "A narrow range of wavelengths in which a substance absorbs light; a series of discrete absorption lines can be used as an unambiguous identification for many relatively simple chemical species."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "absorption line"@en ;
    skos:topConceptOf goldbook: ;
