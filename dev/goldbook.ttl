    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00315.ttl> ;
    skos:definition "An organism that does not need free-form oxygen for growth. Many anaerobes are even sensitive to free oxygen. Obligate (strict) anaerobes grow only in the absence of oxygen. Facultative anaerobes can grow either in the presence or in the absence of molecular oxygen."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "anaerobe"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00315> ;
.

