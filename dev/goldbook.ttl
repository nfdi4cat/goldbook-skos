goldbook:00302
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00302"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00302.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00302.ttl> ;
    skos:definition "The property of surface activity is usually due to the fact that the molecules of the substance are amphipathic or amphiphilic, meaning that each contains both a hydrophilic and a hydrophobic (lipophilic) group. This assumes that one of the two phases is aqueous, and the other non-aqueous. If both are non-aqueous (e.g. oil/air), molecules containing organophilic and organophobic groups may be amphipathic and surface active."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amphipathic"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00302> ;
.

goldbook:00303
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00303"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00303.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00303.ttl> ;
    skos:definition """A term used to describe a compound containing a large organic cation or anion which possesses a long unbranched hydrocarbon chain, e.g. 

$\\ce{CH3(CH2)_{n}CO2^{−}M^{+}}$$\\ce{CH3(CH2)_{n}N^{+}(CH3)3X^{−}}$ ($n \\gt 7$)$\\ce{CH3(CH2)_{n}SO3^{−}M^{+}}$.The existence of distinct polar (hydrophilic) and nonpolar (hydrophobic) regions in the molecule promotes the formation of micelles in dilute aqueous solution."""@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amphiphilic"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00303> ;
.

goldbook:00304
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00304"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00304.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00304.ttl> ;
    skos:altLabel "amphiprotic"@en ;
    skos:definition "Self-ionizing solvent possessing both characteristics of Brønsted acids and bases, for example $\\ce{H2O}$ and $\\ce{CH3OH}$, in contrast to aprotic solvent."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amphiprotic solvent"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00304> ;
.

goldbook:00306
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00306"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00306.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00306.ttl> ;
    skos:definition "A chemical species that behaves both as an acid and as a base is called amphoteric. This property depends upon the medium in which the species is investigated: $\\ce{H2SO4}$ is an acid when studied in water, but becomes amphoteric in superacids."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amphoteric"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00306> ;
.

goldbook:00307
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00307"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00307.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00307.ttl> ;
    skos:definition "A reaction which replaces the conventional reaction used in a particular determination so that a more favourable measurement can be made. The sequence can be repeated to provide a further favourable increase in measurement."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amplification reaction"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00307> ;
.

goldbook:00310
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00310"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00310.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00310.ttl> ;
    skos:definition "Half the peak-to-peak amplitude of a sinusoidal alternating current."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amplitude of alternating current"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00310> ;
.

goldbook:00311
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00311"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00311.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00311.ttl> ;
    skos:definition "This term should denote half of the peak-to-peak amplitude. Peak-to-peak and r.m.s. amplitudes should be so specified."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amplitude of alternating voltage"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00311> ;
.

goldbook:00312
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00312"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00312.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00312.ttl> ;
    skos:altLabel
        "AM"@en ,
        "AM 0"@en ;
    skos:definition "Solar irradiance in space just above the atmosphere of the earth on a plane perpendicular to the direction of the sun (air mass, AM, zero). Also called extraterrestrial irradiance."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "AM 0 sunlight"@en ;
    skos:topConceptOf goldbook: ;
