    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs14xxx/14427.ttl> ;
    skos:definition "Group of organisms of the same age within a population."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "age class"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.14427> ;
.

goldbook:14428
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "14428"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs14xxx/14428.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs14xxx/14428.ttl> ;
    skos:definition "Distribution of organisms among the various age classes present in the population. The sum of the number of individuals in all age classes equals the population size."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "age composition"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.14428> ;
.

goldbook:14429
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "14429"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs14xxx/14429.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs14xxx/14429.ttl> ;
    skos:definition "Composition of a population in terms of how its abundance is distributed across age classes."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "age distribution"@en ;
    skos:topConceptOf goldbook: ;
