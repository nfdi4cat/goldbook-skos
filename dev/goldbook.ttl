    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs14xxx/14421.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs14xxx/14421.ttl> ;
    skos:definition """Of short duration, in relation to exposure or effect; the effect usually shows a rapid onset.
Note 1: In regulatory toxicology, 'acute' refers to studies where dosing is either single or limited to one day although the total study duration may extend to two weeks to permit appearance of toxicity in susceptible organ systems.
Note 2: In aquatic ecotoxicology, exposure of the test organisms is typically continuous and of four days or less.
In clinical medicine, sudden and severe, having a rapid onset."""@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "acute"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.14421> ;
.

goldbook:14422
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "14422"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs14xxx/14422.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs14xxx/14422.ttl> ;
    skos:altLabel "ACR"@en ;
    skos:definition "Numerical dimensionless quantity that is the ratio of an acute toxicity test result (e.g., \\(\\pu{LC_{50}}\\)) to a chronic toxicity test result (e.g., maximum acceptable toxicant concentration, MATC) where both are expressed in the same units (e.g., \\(\\pu{mg L-1}\\)). Ideally, the data are for the same chemical species."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "acute-to-chronic toxicity ratio"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.14422> ;
.

goldbook:14423
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "14423"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs14xxx/14423.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs14xxx/14423.ttl> ;
    skos:definition "Consequence that follows exposure to two or more physicochemical agents that act jointly but do not interact: the total effect is the simple sum of the effects of separate exposures to the agents under the same conditions."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "additive effect"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.14423> ;
.

goldbook:14424
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "14424"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs14xxx/14424.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs14xxx/14424.ttl> ;
    skos:definition "Quantification of the joint action of toxicants in mixture by adding measures of their toxicity calculated in relation to the toxicity of a reference toxicant."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "additive index"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.14424> ;
.

goldbook:14425
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "14425"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs14xxx/14425.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs14xxx/14425.ttl> ;
    skos:altLabel "AEC"@en ;
    skos:definition "Index reflecting the balance of energy transfer between catabolic and anabolic processes, calculated from the equation \\[\\rm{AEC} = ([\\ce{ATP}] + ½[\\ce{ADP})/([\\ce{ATP}] + [\\ce{ADP}] + [\\ce{AMP}])\\] where \\(\\ce{ATP}\\), \\(\\ce{ADP}\\), and \\(\\ce{AMP}\\) are the amount concentrations of adenosine tri-, di-, and monophosphate, respectively."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "adenylate energy charge"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.14425> ;
.

goldbook:14426
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "14426"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs14xxx/14426.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs14xxx/14426.ttl> ;
    skos:definition "Ratio of the amount of substance adsorbed at the interface of a condensed layer and a liquid or gaseous phase to the total amount of the substance available for adsorption."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "adsorption factor"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.14426> ;
.

goldbook:14427
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "14427"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
