    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00053.ttl> ;
    skos:definition "Acceleration of free fall in vacuum due to gravity. Also called acceleration due to gravity."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "acceleration of free fall"@en ;
    skos:topConceptOf goldbook: ;
