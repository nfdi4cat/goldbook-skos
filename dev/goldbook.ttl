    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00179.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00179.ttl> ;
    skos:definition "The sum of all the separate ion currents carried by the different ions contributing to the spectrum."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "after mass analysis"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00179> ;
.

goldbook:00180
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00180"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00180.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00180.ttl> ;
    skos:definition "The time-dependent change of those properties of a precipitate, e.g. loss of water, growth of crystals, recrystallization, decrease of the specific surface, loss of coprecipitated substances, which generally improve the filtering properties. The process of ageing is very often promoted by maintaining the precipitate and precipitation medium together at elevated temperatures for a period of time. The terms chemical, physical and thermal ageing may be used in cases in which some of the (usually combined) effects named above are to be emphasized specifically."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "ageing of precipitate"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00180> ;
.

goldbook:00182
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00182"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00182.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00182.ttl> ;
    skos:altLabel
        "coagulation"@en ,
        "flocculation"@en ;
    skos:definition "Process of contact and adhesion whereby dispersed particles are held together by weak physical interactions ultimately leading to phase separation by the formation of precipitates of larger than colloidal size."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "agglomeration"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00182> ;
.

goldbook:00183
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00183"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00183.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00183.ttl> ;
    skos:definition "An immunochemical reaction leading to the aggregation of particulate matter such as bacteria, erythrocytes or other cells, or synthetic particles such as plastic beads coated with antigens or antibodies."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "agglutination"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00183> ;
.

goldbook:00184
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00184"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00184.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00184.ttl> ;
    skos:definition "Certain materials used as catalysts or supports consist of spheroids smaller than \\(10\\ \\rm{nm}\\) in diameter, cemented into larger entities. A primary particle should be defined as the smallest discrete identifiable entity and the method of identification should be mentioned (e.g. transmission electron microscopy, scanning electron microscopy). An assemblage of such primary particles exhibiting an identifiable collective behaviour (e.g. chemical nature of the aggregated primary particles, texture of the aggregate, resistance to mechanical separation upon grinding) constitutes an aggregate. When describing the aggregates the criterion of identification should be mentioned. Strongly bonded aggregates are called agglomerates."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "aggregate"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00184> ;
.

goldbook:00185
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00185"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00185.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00185.ttl> ;
    skos:altLabel "aglycone"@en ;
    skos:definition "The non-sugar compound remaining after replacement of the glycosyl group from a glycoside by a hydrogen atom."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "aglycon"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00185> ;
.

goldbook:00186
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00186"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00186.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00186.ttl> ;
    skos:definition "Substance which binds to cell receptors normally responding to naturally occurring substances and which produces a response of its own."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "agonist"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00186> ;
.

goldbook:00187
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00187"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00187.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00187.ttl> ;
    skos:definition "The term designates structures in which a hydrogen atom is bonded to both a carbon atom and a metal atom. The term is also used to characterize the interaction between a $\\ce{CH}$ bond and an unsaturated metal centre, and to describe similar bonding of a transition metal with $\\ce{Si–H}$ compounds. The expression '$\\mu$-hydrido-bridged' is also used to describe the bridging hydrogen."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "agostic"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00187> ;
.

goldbook:00188
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00188"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00188.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00188.ttl> ;
    skos:definition "A monogranular or monolithic carbon material with homogeneous microstructure which does not exhibit any structural components distinguishable by optical microscopy."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "agranular carbon"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00188> ;
.

goldbook:00190
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00190"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00190.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00190.ttl> ;
    skos:definition "A substance, gaseous material or aerosol, which is present in an air mass at levels greater than in clean air. An air contaminant has been added commonly by anthropogenic activity."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "air contaminant"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00190> ;
.

goldbook:00191
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00191"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00191.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00191.ttl> ;
    skos:definition "A bioreactor in which the reaction medium is kept mixed and gassed by introduction of air or another gas (mixture) at the base of a column-like reactor equipped either with a draught tube or another device (e.g. external tube) by which the reactor volume is separated into a gassed and an ungassed region thus generating a vertically circulating flow."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "air-lift bioreactor"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00191> ;
.

goldbook:00192
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00192"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00192.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00192.ttl> ;
    skos:definition "A qualitative term to describe a widespread body of air with approximately uniform characteristics which had been identified at a given time over a particular region of the earth's surface. Sometimes an air mass is marked by inert tracers such as $\\ce{SF6}$ which may be added to it. The composition of a given air mass undergoes alteration as it migrates, chemical changes occur, compounds are removed by dry and wet deposition and new impurities are added to the mass."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "air mass"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00192> ;
.

goldbook:00193
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00193"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00193.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00193.ttl> ;
    skos:altLabel
        "BAPMoN"@en ,
        "WMO"@en ;
    skos:definition "A site at which monitoring of the concentration of one or more pollutants is carried out (e.g. the BAPMoN stations, Background Air Pollution Monitoring Network of the WMO, World Meteorological Organization)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "air monitoring station"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00193> ;
.

goldbook:00194
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00194"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00194.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00194.ttl> ;
    skos:altLabel
        "pollutant"@en ,
        "pollution"@en ;
    skos:definition "A substance, gaseous material or aerosol which has been introduced into the air (either by human activity or by natural processes) in sufficient concentration to produce a measurable effect on humans, animals, vegetation or materials (monuments, etc.): $\\ce{SO2}$, $\\ce{NO2}$, $\\ce{H2S}$, $\\ce{CO}$, hydrocarbons, etc."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "air pollutant"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00194> ;
.

goldbook:00195
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00195"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00195.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00195.ttl> ;
    skos:definition "Usually the presence of substances in the atmosphere, resulting either from human activity or natural processes, present in sufficient concentration, for a sufficient time and under circumstances such as to interfere with comfort, health or welfare of persons or the environment."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "air pollution"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00195> ;
.

goldbook:00196
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00196"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00196.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00196.ttl> ;
    skos:altLabel "air quality index"@en ;
    skos:definition "A mathematical combination of the concentrations of air pollutants (weighted in some fashion to reflect the estimated health impact of the specific pollutant) which gives an approximate numerical measure of the quality of the air at a given time. These indices have little scientific basis but have been used to inform the public (in a qualitative fashion) of the degree of pollution present at a given time. It is recommended that the actual measured pollutant concentrations be used by all information services when possible with simultaneous reference given to the corresponding concentrations which are considered by health authorities to be hazardous to human health."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "air pollution index"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00196> ;
.

goldbook:00197
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00197"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00197.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00197.ttl> ;
    skos:definition "A study of the concentrations and geographical distribution of specified air pollutants in a given area and an assessment of the damage, if any, which the pollutants have caused."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "air pollution survey"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00197> ;
.

goldbook:00198
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00198"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00198.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00198.ttl> ;
    skos:definition "One of the quantifiable properties relating to an air sample: concentration of a constituent, wind speed, temperature, etc. The quantity of air quality characteristic is the true value of the characteristic being investigated; it is recognized that in practice, this value can only be approximated by existing methods."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "air quality characteristic"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00198> ;
.

goldbook:00199
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00199"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00199.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00199.ttl> ;
    skos:definition "The detailed planning and the implementation of air pollution control programs designed to preserve the health and welfare of the people in the region, the plant and animal life, physical property, good visibility and other factors which determine the air quality and the maintenance of an aesthetically acceptable environment."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "air resource management"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00199> ;
.

goldbook:00200
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00200"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00200.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00200.ttl> ;
    skos:definition "A number of air sampling stations which are established in a given geographical region at which measurements of both pollutant concentrations and meteorological quantities (wind speed, direction, rain fall, humidity, etc.) are made to determine the extent and the nature of the air pollution and to establish trends in the concentrations of the air pollutants with time."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "air sampling network"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00200> ;
.

goldbook:00201
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00201"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00201.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00201.ttl> ;
    skos:definition "Aerosol particles below \\(0.1\\ \\unicode[Times]{x3BC}\\rm{m}\\) in diameter. These generally are the most numerous among all particles in the air. Their concentrations can be determined with the Aitken counter which measures total particle number density. Owing to their small size, Aitken particles contribute little to the total mass concentration of all aerosol particles; this is determined primarily by particles of diameter \\(> 0.1\\ \\unicode[Times]{x3BC}\\rm{m}\\)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "Aitken particles"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00201> ;
.

goldbook:00202
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00202"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00202.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00202.ttl> ;
    skos:definition "The fraction of the energy of electromagnetic radiation reflected from a body (or surface) relative to the energy incident upon it. The reflection of light from a surface is, of course, dependent on the wavelength of the light, the nature of the surface and its angle of incidence with the surface. The term albedo usually connotes a broad wavelength band (visible, ultraviolet or infrared), whereas the terms reflectivity and spectral albedo are used to describe the reflection of monochromatic (single wavelength or small band of wavelengths) radiation."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "albedo"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00202> ;
.

goldbook:00203
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00203"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00203.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00203.ttl> ;
    skos:definition "Synonymous with alkoxides. Alcoholate should not be used for solvates derived from an alcohol such as $\\ce{CaCl2.nROH}$, for the ending -ate often occurs in names for anions."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alcoholates"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00203> ;
.

goldbook:00204
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00204"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00204.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00204.ttl> ;
    skos:definition "Compounds in which a hydroxy group, $\\ce{-OH}$, is attached to a saturated carbon atom $\\ce{R3COH}$. The term 'hydroxyl' refers to the radical species, $\\ce{HO^{.}}$."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alcohols"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00204> ;
.

goldbook:00206
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
