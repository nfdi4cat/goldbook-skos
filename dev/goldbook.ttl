    skos:definition "Synonymous with ammonium ylides"@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amine ylides"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00275> ;
.

goldbook:00277
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00277"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00277.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00277.ttl> ;
    skos:definition "Cations $\\ce{HR3N^{+}}$ formed by hydronation of an amine $\\ce{R3N}$. 'Non-quaternary ammonium ions' is a synonymous term, e.g. prolinium, $\\ce{PhN^{+}HMe2}$, $N,N$-dimethylanilinium."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "aminium ions"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00277> ;
.

goldbook:00278
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00278"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00278.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00278.ttl> ;
    skos:definition "Radicals cations, $\\ce{R3N^{.+}}$, derivable from aminium ions, $\\ce{R3NH^{+}}$, by removal of a hydrogen atom. Aminiumyl radical ions are, except for $\\ce{H3N^{.+}}$, synonymous with the ammoniumyl radical ions. As the term ammonium is well known, ammoniumyl radical ions is the more desirable class name."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "aminiumyl radical ions"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00278> ;
.

goldbook:00279
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00279"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00279.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00279.ttl> ;
    skos:definition "When two or more amino acids combine to form a peptide, the elements of water are removed, and what remains of each amino acid is called an amino-acid residue. $\\ce{\\upalpha\\!\\mbox{-}Amino-acid}$ residues are therefore structures that lack a hydrogen atom of the amino group ($\\ce{–NH–CHR–COOH}$), or the hydroxyl moiety of the carboxyl group ($\\ce{NH2–CHR–CO\\bond{–}}$), or both ($\\ce{–NH–CHR–CO\\bond{–}}$); all units of a peptide chain are therefore amino-acid residues. (Residues of amino acids that contain two amino groups or two carboxyl groups may be joined by isopeptide bonds, and so may not have the formulas shown.) The residue in a peptide that has an amino group that is free, or at least not acylated by another amino-acid residue (it may, for example, be acylated or formylated), is called N-terminal; it is at the N-terminus. The residue that has a free carboxyl group, or at least does not acylate another amino-acid residue, (it may, for example, acylate ammonia to give $\\ce{–NH–CHR–CO–NH2}$), is called C-terminal."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amino-acid residue"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00279> ;
.

goldbook:00283
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00283"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00283.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00283.ttl> ;
    skos:definition "Monosaccharides having one alcoholic hydroxy group (commonly but not necessarily in position 2) replaced by an amino group; systematically known as $x$-amino-$x$-deoxymonosaccharides. (Glycosylamines are excluded.) E.g. ᴅ-glucosamine or 2-amino-2-deoxy-ᴅ-glucopyranose."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amino sugars"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00283> ;
.

goldbook:00284
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00284"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00284.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00284.ttl> ;
    skos:definition "The anion $\\ce{H2N–O^{−}}$, aminoxide and its $\\ce{N}$ hydrocarbyl derivatives $\\ce{R2N–O^{−}}$; formally derived from hydroxylamines, $\\ce{R2N–OH}$, by removing a hydron from the hydroxy group, e.g. $\\ce{(CH3)2N–O^{−}}$ dimethylaminoxide."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "aminoxides"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00284> ;
.

goldbook:00285
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00285"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00285.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00285.ttl> ;
    skos:altLabel
        "aminooxyl radicals"@en ,
        "iminooxy radicals"@en ;
    skos:definition "Compounds having the structure $\\ce{R2N–O^{.}  R2N^{.+}–O^{−}}$; they are radicals derived from hydroxylamines by removal of the hydrogen atom from the hydroxy group, and are in many cases isolable. The synonymous terms 'nitroxyl radicals' and 'nitroxides' erroneously suggest the presence of a nitro group; their use is not desirable. Example, $\\ce{(ClCH2)2N–O^{.}}$ bis(chloromethyl)aminoxyl."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "aminoxyl radicals"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00285> ;
.

goldbook:00289
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00289"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00289.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00289.ttl> ;
    skos:definition "The nitrogen-centered radical $\\ce{H2N^{.}}$, formally derived by the removal of a hydrogen atom from ammonia, and its hydrocarbyl derivatives $\\ce{R2N^{.}}$."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "aminyl radicals"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00289> ;
.

goldbook:00292
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00292"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00292.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00292.ttl> ;
    skos:definition "1,2-Dipolar compounds of general structure $\\ce{R3N^{+}–C^{−}R2}$."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "ammonium ylides"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00292> ;
.

goldbook:00293
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00293"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00293.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00293.ttl> ;
    skos:definition "$\\ce{H3N^{.+}}$ and its hydrocarbyl derivatives, e.g. $\\ce{(CH3)3N^{.+}}$ trimethylammoniumyl, $\\ce{PhN^{.+}H2}$ phenylammoniumyl or benzenaminiumyl."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "ammoniumyl radical ions"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00293> ;
.

goldbook:00294
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00294"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00294.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00294.ttl> ;
    skos:definition "A carbon material without long-range crystalline order. Short-range order exists, but with deviations of the interatomic distances and/or interbonding angles with respect to the graphite lattice as well as to the diamond lattice."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amorphous carbon"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00294> ;
.

goldbook:00298
    a skos:Concept ;
