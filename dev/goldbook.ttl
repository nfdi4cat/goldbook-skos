    skos:definition "Carbenes $\\ce{R2C…}$ containing a univalent carbon atom, atom, e.g. $\\ce{CH3CH2C…}$ propylidyne"@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alkylidynes"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00234> ;
.

goldbook:00235
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00235"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00235.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00235.ttl> ;
    skos:definition "Carbon-centered radicals derived formally by removal of one hydrogen atom from an alkane, e.g. $\\ce{CH3CH2C^{.}H2}$ propyl."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alkyl radicals"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00235> ;
.

goldbook:00236
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00236"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00236.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00236.ttl> ;
    skos:definition "Acyclic branched or unbranched hydrocarbons having a carbon-carbon triple bond and the general formula $\\ce{C_{n}H_{2n-2}}$, $\\ce{RC#CR}$. Acyclic branched or unbranched hydrocarbons having more than one triple bond are known as alkadiynes, alkatriynes, etc."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alkynes"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00236> ;
.

goldbook:00237
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00237"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00237.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00237.ttl> ;
    skos:definition "One of several alternate forms of a gene which occur at the same locus on homologous chromosomes and which become separated during meiosis and can be recombined following fusion of gametes."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "allele"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00237> ;
.

goldbook:00238
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00238"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00238.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00238.ttl> ;
    skos:definition "Hydrocarbons (and by extension, derivatives formed by substitution) having two double bonds from one carbon atom to two others $\\ce{R2C=C=CR2}$. (The simplest member, propadiene, is known as allene)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "allenes"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00238> ;
.

goldbook:00239
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00239"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00239.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00239.ttl> ;
    skos:definition "Amino acids with two chiral centres were named in the past by allotting a name to the first diastereoisomer to be discovered. The second diastereoisomer, when found or synthesized, was then assigned the same name but with the prefix allo-. This method can be used only with trivial names but not with semisystematic or systematic names. It is now recommended that allo should be used only for alloisoleucine and allothreonine."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "allo-"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00239> ;
.

goldbook:00240
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00240"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00240.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00240.ttl> ;
    skos:definition "Enzymes which contain regions to which small, regulatory molecules (cf. effector) may bind in addition to and separate from substrate binding sites. On binding the effector, the catalytic activity of the enzyme towards the substrate may be enhanced, in which case the effector is an activator, or reduced, in which case it is an inhibitor."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "allosteric enzymes"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00240> ;
.

goldbook:00241
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00241"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00241.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00241.ttl> ;
    skos:definition "A phenomenon whereby the conformation of an enzyme or other protein is altered by combination, at a site other than the substrate-binding site, with a small molecule, referred to as an effector, which results in either increased or decreased activity by the enzyme."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "allostery"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00241> ;
.

goldbook:00243
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00243"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00243.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00243.ttl> ;
    skos:definition "Different structural modifications of an element."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "allotropes"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00243> ;
.

goldbook:00244
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00244"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00244.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00244.ttl> ;
    skos:altLabel "allotriomorphic transition"@en ;
    skos:definition "A transition of a pure element, at a defined temperature and pressure, from one crystal structure to another which contains the same atoms but which has different properties. Examples: The transition of graphite to diamond, that of body-centred-cubic iron to face-centred-cubic iron, and the transition of orthorhombic sulfur to monoclinic sulfur."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "allotropic transition"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00244> ;
.

goldbook:00245
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00245"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00245.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00245.ttl> ;
    skos:definition "The group $\\ce{CH2=CHCH2}$ (allyl) and derivatives formed by substitution. The term 'allylic position' or 'allylic site' refers to the saturated carbon atom. A group, such as $\\ce{–OH}$, attached at an allylic site is sometimes described as 'allylic'."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "allylic groups"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00245> ;
.

goldbook:00246
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00246"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00246.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00246.ttl> ;
    skos:definition "Carbanions, carbenium ions or radicals, formally derived by detachment of one hydron, hydride or hydrogen from the $\\ce{CH3}$ group of propene or derivatives thereof. E.g. $\\ce{H2C=CHCH2^{+}}$ allyl cation."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "allylic intermediates"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00246> ;
.

goldbook:00247
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00247"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00247.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00247.ttl> ;
    skos:definition "A substitution reaction occurring at position 1/ of an allylic system, the double bond being between positions 2/ and 3/. The incoming group may be attached to the same atom 1/ as the leaving group, or the incoming group becomes attached at the relative position 3/, with movement of the double bond from 2/3 to 1/2. For example:  (written as a transformation)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "allylic substitution reaction"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00247> ;
.

goldbook:00249
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00249"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00249.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00249.ttl> ;
    skos:definition "A conjugated system of $\\ce{\\uppi\\!\\mbox{-}electrons}$ is termed alternant if its atoms can be divided into two sets so that no atom of one set is directly linked to any other atom of the same set."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alternant"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00249> ;
.

goldbook:00250
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00250"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00250.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00250.ttl> ;
    skos:definition "A copolymer consisting of macromolecules comprising two species of monomeric units in alternating sequence."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alternating copolymer"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00250> ;
.

goldbook:00251
    a skos:Concept ;
