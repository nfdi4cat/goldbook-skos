    skos:definition "Carbenes, derived by formal insertion of a divalent carbon atom into an even-membered annulene, e.g. cycloheptatrienylidene:"@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "annulenylidenes"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00369> ;
.

