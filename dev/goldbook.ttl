    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00495.ttl> ;
    skos:definition "A gas laser which is pumped using energy transfer from other atoms or molecules. Examples are the helium-neon ($\\ce{HeNe}$) and the copper vapour laser."@en ;
