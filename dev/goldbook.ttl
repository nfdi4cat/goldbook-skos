    skos:prefLabel "atomization surface temperature"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00507> ;
.

goldbook:00508
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00508"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00508.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00508.ttl> ;
    skos:definition "To subdivide a liquid into very small particles; methods include: impact with a jet of gas, use of a spinning disk generator, vibrating orifice generator, etc."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "atomize"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00508> ;
.

goldbook:00509
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00509"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00509.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00509.ttl> ;
    skos:definition "Any system which is capable of converting the analyte into atomic vapour."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "atomizer"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00509> ;
.

goldbook:00510
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00510"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00510.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00510.ttl> ;
    skos:definition "A mechanism that sometimes applies to the combination of atoms, but rarely of free radicals. In this mechanism the atom A first combines with a third body or chaperon, $$\\ce{A + M -> AM}$$ and the complex AM then forms $\\ce{A2 + M}$ by collision with another atom $\\ce{A}$. Contrast the energy-transfer mechanism."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "atom–molecule complex mechanism"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00510> ;
.

goldbook:00512
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00512"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00512.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00512.ttl> ;
    skos:definition "A transformation by which one molecular entity (the substrate) is converted into another by the formation of one (and only one) two-centre bond between the substrate and another molecular entity and which involves no other changes in connectivity in the substrate. For example, the formation of an acyl cation by attachment of carbon monoxide to a carbenium ion ($\\ce{R^{+}}$):  The product of an attachment may also be the adduct of the two reactants, but not all adducts can be represented as the products of an attachment. (For example, the Diels–Alder cycloaddition:  results in an adduct of buta-1,3-diene and ethene, but the reaction cannot be described as an attachment since bonds are formed between more than two centres.)"@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "attachment"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00512> ;
.

goldbook:00514
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00514"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00514.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00514.ttl> ;
    skos:altLabel "neutral-density filter"@en ;
    skos:definition "An optical device (filter) which reduces the radiant power of a light beam by a constant factor over all wavelengths within its operating range. Sometimes called attenuator or neutral density filter."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "attenuance filter"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00514> ;
.

goldbook:00516
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00516"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00516.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00516.ttl> ;
    skos:altLabel "extinction coefficient"@en ;
    skos:definition "Analogous to absorption coefficient but taking into account also the effects due to scattering and luminescence. It was formerly called extinction coefficient."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "attenuation coefficient"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00516> ;
.

goldbook:00518
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00518"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00518.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00518.ttl> ;
    skos:altLabel "AMR"@en ;
    skos:definition "A classification of potential-energy surfaces in which a highly attractive surface is at one extreme and a highly repulsive surface is at the other. The energy release in intermediate cases is referred to as mixed."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "attractive–mixed–repulsive classification"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00518> ;
.

goldbook:00519
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00519"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00519.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00519.ttl> ;
    skos:altLabel "early-downhill surface"@en ;
    skos:definition "A potential-energy surface for a process A + B–C in which the initial descent of the system into the product valley is associated with a substantial decrease in the A–B distance and with little separation between the products A–B and C. In terms of a potential-energy profile, the energy barrier occurs in the early stage of the reaction path. Attractive surfaces are also called early-downhill surfaces, and the barrier in such a surface is called a Type-I barrier."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "attractive potential-energy surface"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00519> ;
.

goldbook:00520
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00520"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00520.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00520.ttl> ;
    skos:definition "The emission of an electron from an atom accompanying the filling of a vacancy in an inner electron shell."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "Auger effect"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00520> ;
.

goldbook:00521
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00521"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00521.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00521.ttl> ;
    skos:definition "Electron originating in the Auger effect."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "Auger electron"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00521> ;
.

goldbook:00522
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00522"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00522.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00522.ttl> ;
    skos:definition "Any technique in which a specimen is bombarded with \\(\\mathrm{keV}\\)-energy electrons or X-rays, and the energy distribution of the electrons produced through radiationless de-excitation of the atoms in the sample (Auger electrons) is recorded. The derivative curve may also be recorded."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "Auger electron spectroscopy"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00522> ;
.

goldbook:00523
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00523"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00523.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00523.ttl> ;
    skos:definition "The fraction of the atoms having a vacancy in an inner orbital which relax by emission of an Auger electron."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "Auger electron yield"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00523> ;
.

goldbook:00525
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00525"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00525.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00525.ttl> ;
    skos:definition "A chemical reaction in which a product (or a reaction intermediate) also functions as a catalyst. In such a reaction the observed rate of reaction is often found to increase with time from its initial value."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "autocatalytic reaction"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00525> ;
.

goldbook:00529
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00529"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00529.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00529.ttl> ;
    skos:definition "If adsorption equilibrium and mutual saturation of the phases is not achieved instantly, it is possible to distinguish the initial spreading tension, \\(\\sigma _{\\rm{i}}^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }\\), from the final spreading tension, \\(\\sigma _{\\rm{i}}^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }\\), when equilibrium has been reached. In the case in which \\(\\sigma _{\\rm{i}}^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }\\) is positive, while \\(\\sigma _{\\rm{i}}^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }\\) is negative, the system is said to exhibit autophobicity."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "autophobicity"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00529> ;
.

goldbook:00531
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00531"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00531.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00531.ttl> ;
    skos:definition "A proton (hydron) transfer reaction between two identical molecules (usually a solvent), one acting as a Brønsted acid and the other as a Brønsted base. For example:"@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "autoprotolysis"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00531> ;
.

goldbook:00532
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00532"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00532.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00532.ttl> ;
    skos:definition "The product of the activities (or, more approximately, concentrations) of the species produced as the result of autoprotolysis. For solvents in which no other ionization processes are significant the term is synonymous with 'ionic product'. The autoprotolysis constant for water, \\(K_{\\rm{w}}\\), is equal to the product of activities: \\[a\\left(\\rm{H}_{3}\\rm{O}^{\\rm{+}}\\right)\\ a\\left(\\rm{OH}^{\\rm{-}}\\right) = 1.0\\times 10^{-14}\\] at \\(25\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "autoprotolysis constant"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00532> ;
.

goldbook:00533
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00533"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00533.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00533.ttl> ;
    skos:definition "A radiograph of an object containing radioactive substance, produced by placing the object adjacent to a photographic plate or film or a fluorescent screen."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "autoradiograph"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00533> ;
.

goldbook:00534
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00534"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00534.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00534.ttl> ;
    skos:definition "Radiolysis of a radioactive material resulting directly or indirectly from its radioactive decay."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "autoradiolysis"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00534> ;
.

goldbook:00535
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00535"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00535.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00535.ttl> ;
    skos:definition "Three-electrode cells comprise (1) an indicator (or test) electrode or a working electrode, at the surface of which processes that are of interest may occur, (2) a reference electrode and (3) a third electrode, the auxiliary or counter electrode, which serves merely to carry the current flowing through the cell, and at the surface of which no processes of interest occur. If processes of interest occur at both the anode and the cathode of a cell (as in differential amperometry or controlled current potentiometric titration with two indicator electrodes), the cell should be said to comprise two indicator (or test) working electrodes."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "auxiliary electrode"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00535> ;
.

goldbook:00536
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00536"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00536.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00536.ttl> ;
    skos:definition "An atom or group which, when added to or introduced into a chromophore, causes a bathochromic shift and/or a hyperchromic effect in a given band of the chromophore, usually in that of lowest frequency. This term is obsolete."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "auxochrome"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00536> ;
.

goldbook:00539
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00539"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00539.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00539.ttl> ;
    skos:definition "The average current density, \\(j\\), is defined by \\[j = A^{-1}\\ \\int _{A}j_{x}\\ \\rm{d}A\\] where \\(A\\) is the electrode area, \\(j_{x}\\) is the local current density and \\(\\rm{d}A\\) is an infinitesimal surface element."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "average current density"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00539> ;
.

goldbook:00540
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00540"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00540.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00540.ttl> ;
    skos:definition "Any average, \\(\\bar{X}_{\\rm{k}}\\), of the degree of polymerization, where \\(\\rm{k}\\) specifies the type of average."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "average degree of polymerization"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00540> ;
.

goldbook:00541
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00541"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00541.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00541.ttl> ;
    skos:definition "Defined for an atom or nuclear system in a specified state. For an exponentially decaying system, it is the average time for the number of atoms or nuclei in a specified state to decrease by a factor e. Synonymous with mean lifetime."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "average life"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00541> ;
.

goldbook:00542
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00542"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00542.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00542.ttl> ;
    skos:definition "The ratio of the mass of a drop, at the instant when it is detached from the tip of the capillary, to the drop time \\(t_{1}\\); the average value of the instantaneous rate of flow over the entire life of the drop."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "average rate of flow"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00542> ;
.

goldbook:00544
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00544"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00544.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00544.ttl> ;
    skos:definition "Frequently, two Born–Oppenheimer electronic states (A, B) change their energy order as molecular geometry (x) is changed continuously along a path. In the process their energies may become equal at some points (the surfaces are said to cross, dotted lines in the figure), or only come relatively close (the crossing of the surfaces is said to be avoided). If the electronic states are of the same symmetry, the surface crossing is always avoided in diatomics and usually avoided in polyatomics.   Synonymous with intended crossing."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "avoided crossing"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00544> ;
.

goldbook:00545
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00545"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00545.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00545.ttl> ;
    skos:definition "An equation, describing crystallization kinetics, of the form: \\[1 - \\varphi _{c} = \\rm{e}^{K\\ t^{n}}\\] where \\(\\varphi _{c}\\) is the crystalline volume fraction developed at time \\(t\\) and constant temperature, \\(K\\) and \\(n\\) are suitable parameters. \\(K\\) is temperature dependent. According to the original theory, \\(n\\) should be an integer from 1 to 4, the value of which should depend only on the type of the statistical model; however, it has become customary to regard it as an adjustable parameter that may be non-integral."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "Avrami equation"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00545> ;
.

