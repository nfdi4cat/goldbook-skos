    skos:definition "O-Alkyl hydroxylamines (with or without substitution on $\\ce{N}$) $\\ce{R'ONR2}$ ($\\ce{R'\\neq H}$)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alkoxyamines"@en ;
    skos:topConceptOf goldbook: ;
