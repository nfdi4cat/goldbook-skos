    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00435> ;
.

goldbook:00436
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00436"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00436.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00436.ttl> ;
    skos:definition "Cations derived formally by the addition of a hydron or other cationic species to any position of an arene, e.g. $\\ce{C6H7^{+}}$, benzenium. The term includes:Arenium σ-adduct (sigma-adduct) (Wheland intermediates) (which are considered to be intermediates in electrophilic aromatic substitution reactions) and other cyclohexadienyl cations. Arenium π-adduct (pi-adduct), such as:"@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "arenium ions"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00436> ;
.

goldbook:00437
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00437"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00437.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00437.ttl> ;
    skos:definition "Synonymous with phenols (but rarely used)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "arenols"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00437> ;
.

goldbook:00439
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00439"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00439.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00439.ttl> ;
    skos:altLabel "CW"@en ;
    skos:definition "A CW or pulsed laser emitting lines from \\(334\\) to \\(529\\ \\rm{nm}\\) from singly ionized argon. Principal emissions are at \\(488.0\\) and \\(514.5\\ \\rm{nm}\\)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "argon ion laser"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00439> ;
.

goldbook:00440
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00440"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00440.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00440.ttl> ;
    skos:altLabel "average"@en ;
    skos:definition "The sum of a series of observations divided by the number of observations. Symbol: \\(\\bar{x}\\). It can be calculated by the formula: \\[\\bar{x}=\\frac{\\sum x_{i}}{n}\\]"@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "arithmetic mean"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00440> ;
.

goldbook:00441
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00441"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00441.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00441.ttl> ;
    skos:definition "In the traditional sense, 'having a chemistry typified by benzene'.A cyclically conjugated molecular entity with a stability (due to delocalization) significantly greater than that of a hypothetical localized structure (e.g. Kekulé structure) is said to possess aromatic character. If the structure is of higher energy (less stable) than such a hypothetical classical structure, the molecular entity is 'antiaromatic'. The most widely used method for determining aromaticity is the observation of diatropicity in the $\\ce{^{1}H}$ NMR spectrum.See also: Hückel (4n + 2) rule, Möbius aromaticityThe terms aromatic and antiaromatic have been extended to describe the stabilization or destabilization of transition states of pericyclic reactions The hypothetical reference structure is here less clearly defined, and use of the term is based on application of the Hückel (4n + 2) rule and on consideration of the topology of orbital overlap in the transition state. Reactions of molecules in the ground state involving antiaromatic transition states proceed, if at all, much less easily than those involving aromatic transition states."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "aromatic"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00441> ;
.

goldbook:00443
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00443"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00443.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00443.ttl> ;
    skos:definition "Equipment designed to remove particles from a gaseous medium."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "arrester"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00443> ;
.

goldbook:00446
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00446"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00446.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00446.ttl> ;
    skos:definition "An equation that represents the dependence of the rate constant \\(k\\) of a reaction on the absolute temperature \\(T\\): \\[k = A\\ \\rm{e}^{\\frac{-E_{\\rm{a}}}{R\\ T}}\\] In its original form the pre-exponential factor \\(A\\) and the activation energy \\(E_{\\rm{a}}\\) are considered to be temperature-independent."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "Arrhenius equation"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00446> ;
.

goldbook:00447
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00447"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00447.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00447.ttl> ;
    skos:definition "The saturated hydrides of tervalent arsenic, having the general formula $\\ce{As_{n}H_{n+2}}$. Individual members having an unbranched arsenic chain are named arsane, diarsane, triarsane, etc. The name of a saturated hydride of arsenic where one or more arsenic atoms have bonding number 5 is formed by prefixing locants and \\(\\lambda ^{5}\\) symbols to the name of the corresponding arsane, e.g. $\\ce{H2AsAsHAsH2}$ triarsane, $\\ce{H4AsAsH3AsH4}$ 1\\(\\lambda ^{5}\\),2\\(\\lambda ^{5}\\),3\\(\\lambda ^{5}\\)-triarsane. Hydrocarbyl derivatives of $\\ce{AsH3}$ belong to the class arsines."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "arsanes"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00447> ;
.

goldbook:00448
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00448"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00448.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00448.ttl> ;
