    skos:definition "One-electron wavefunction obtained as a solution of the Schrödinger equation for an atom."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "atomic orbital"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00500> ;
.

goldbook:00502
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00502"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00502.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00502.ttl> ;
    skos:definition "Atomic and ionic spectral lines originate from specified electronic transitions between energy levels of atoms and ions, respectively. In the past it has been common usage to denote atomic lines as arc lines and ionic lines as spark lines. This usage is now considered to be incorrect. The correct way to indicate that lines are due to atomic or ionic transitions is: Element symbol I wavelength, e.g., Cu I \\(324.7\\ \\rm{nm}\\); and Element symbol II wavelength, e.g., Cu II \\(213.6\\ \\rm{nm}\\). Similarly for higher states of ionization, the type of line is represented by III, IV, etc."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "atomic spectral lines"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00502> ;
.

goldbook:00503
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00503"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00503.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00503.ttl> ;
    skos:definition "One, two or three letters used to represent the atom in chemical formulae."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "atomic symbol"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00503> ;
.

goldbook:00504
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00504"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00504.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00504.ttl> ;
    skos:definition "The units designed to simplify the form of the fundamental equations of quantum mechanics by eliminating from them fundamental constants. The atomic unit of length is the Bohr radius, \\(a_{\\rm{o}}=\\frac{h^{2}}{4\\ \\pi ^{2}\\ m\\ e^{2}}=5.291\\ 77249\\times 10^{-11}\\ \\rm{m}\\) (\\(0.529177249\\ \\mathring{\\rm{A}}\\)). Energy is measured in hartrees, where \\(1\\ \\rm{hartree} = \\frac{e^{2}}{a_{\\rm{o}}}=4.359\\ 7482\\times 10^{-18}\\ \\rm{J}\\). Masses are specified in terms of atomic mass unit, \\(\\pu{amu} = \\pu{1.6605402E-27 kg}\\) and of the electron mass unit, \\(m_{\\rm{e}} = \\pu{0.910953E-30 kg}\\). The advantage of atomic units is that if all calculations are directly expressed in such units, the results do not vary with any revision of the numerical values of the fundamental constants."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "atomic units"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00504> ;
.

goldbook:00506
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00506"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00506.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00506.ttl> ;
    skos:definition "The conversion of volatilized analyte into free atoms."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "atomization"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00506> ;
.

goldbook:00507
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00507"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00507.ttl> ;
