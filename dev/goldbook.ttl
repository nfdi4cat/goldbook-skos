    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00349.ttl> ;
    skos:altLabel "Baeyer strain"@en ;
    skos:definition "Strain due to a departure in bond angle from 'normal' values. The term is often used in the context of non-aromatic cyclic compounds in which the internal angles differ from the regular tetrahedral angle of \\(109^{\\,\\unicode{x26ac}}\\,28^{\\prime }\\); in this sense angle strain is also known as 'Baeyer strain'."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "angle strain"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00349> ;
.

goldbook:00351
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00351"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
