goldbook:00012
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00012"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00012.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00012.ttl> ;
    skos:altLabel "Winstein–Holness A value"@en ;
    skos:definition "The conformational preference of an equatorial compared to an axial substituent in a monosubstituted cyclohexane. This steric substituent parameter equals \\(\\Delta _{\\rm{r}}G^{\\,\\unicode{x26ac}}\\) in \\(\\pu{kcal mol-1}\\) for the equatorial to axial equilibration on cyclohexane. The values are also known as 'Winstein–Holness' A values."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "'A' value"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00012> ;
.

goldbook:00013
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00013"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00013.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00013.ttl> ;
    skos:definition "Action taken to reduce air pollution which involves the use of control equipment or some new process. This refers to a reduction or lessening as opposed to elimination of a type of discharge or pollutant."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "abatement"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00013> ;
.

goldbook:00014
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00014"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-06"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00014.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00014.ttl> ;
    skos:definition "Bond migration, i.e. the formal transfer of one end of a skeletal bond to another position, with a compensating transfer of a hydrogen atom, can be indicated by a prefix of the form '\\(x(y\\rightarrow z)abeo-\\)'. The prefix is compiled as follows: a numeral denoting the stationary (unchanged) end of the migrating bond (x) is followed by parentheses enclosing the locant denoting the original position (y) from which the other end of this bond has migrated, an arrow, and the locant (z) denoting the new position to which the bond has moved. The closing parenthesis is followed by the italicized prefix abeo- (Latin: I go away) to indicate bond migration. The original numbering is retained for the new compound and is used for the numbers x, y and z. It is always necessary to specify the resulting stereochemistry."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "abeo-"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00014> ;
.

goldbook:00016
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00016"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00016.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00016.ttl> ;
    skos:altLabel "abiological"@en ;
    skos:definition "Not associated with living organisms. Synonymous with abiological."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "abiotic"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00016> ;
.

goldbook:00017
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00017"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00017.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
