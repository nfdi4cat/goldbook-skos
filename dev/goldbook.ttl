goldbook:00159
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00159"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00159.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00159.ttl> ;
    skos:definition "A faradaic current whose magnitude depends on the applied potential, and, at any particular applied potential, on the rate or extent of the adsorption of an electroactive substance (or the product obtained from the reduction or oxidation of an electroactive substance) onto the surface of the indicator or working electrode."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "adsorption current"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00159> ;
.

