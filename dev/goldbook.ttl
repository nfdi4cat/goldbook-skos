    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00233.ttl> ;
    skos:definition "Carbenes $\\ce{R2C{:}}$ formed by mono or dialkyl substitution of methylene, $\\ce{H2C{:}}$, e.g. $\\ce{CH3CH2CH{:}}$ propylidene."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alkylidenes"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00233> ;
.

goldbook:00234
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00234"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
