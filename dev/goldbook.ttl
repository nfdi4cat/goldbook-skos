    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00351.ttl> ;
    skos:definition "With reference to the center of mass, the products of a bimolecular reaction are scattered with respect to the initial velocity vector, and the distribution of scattering angles is known as the angular distribution."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "angular distribution"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00351> ;
.

