    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00352.ttl> ;
    skos:altLabel
        "circular frequency"@en ,
        "pulsatance"@en ;
    skos:definition "Frequency multiplied by $2\\uppi\\!$. Also called pulsatance. It was formerly called circular frequency."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "angular frequency"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00352> ;
.

goldbook:00353
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00353"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00353.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00353.ttl> ;
    skos:definition "Angular momentum, or moment of momentum of a particle about a point is a vector quantity equal to the vector product of the position vector of the particle and its momentum, \\(L=r\\times p\\). For special angular momenta of particles in atomic and molecular physics different symbols are used."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "angular momentum"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00353> ;
.

goldbook:00490
    a skos:Concept ;
