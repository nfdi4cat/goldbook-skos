goldbook:00227
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00227"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00227.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00227.ttl> ;
    skos:definition "An old term, which is not recommended, for alkenes, especially those of low molecular weight.An old term for alkanediyl groups commonly but not necessarily having the free valencies on adjacent carbon atoms, e.g. $\\ce{–CH(CH3)CH2\\bond{–}}$ propylene (systematically called propane-1,2-diyl)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alkylenes"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00227> ;
.

goldbook:00228
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00228"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00228.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00228.ttl> ;
    skos:definition "Univalent groups derived from alkanes by removal of a hydrogen atom from any carbon atom $\\ce{–C_{n}H_{2n+1}}$. The groups derived by removal of a hydrogen atom from a terminal carbon atom of unbranched alkanes form a subclass of normal alkyl ($n$-alkyl) groups $\\ce{H(CH2)_{n}}$. The groups $\\ce{RCH2}$, $\\ce{R2CH}$ ($\\ce{R \\neq H}$), and $\\ce{R3C}$ ($\\ce{R \\neq H}$) are primary, secondary and tertiary alkyl groups, respectively."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alkyl groups"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00228> ;
.

goldbook:00230
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00230"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00230.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00230.ttl> ;
    skos:definition "Radicals having the structure $\\ce{R2C=N–O^{.}}$. Synonymous with iminoxyl radicals."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alkylideneaminoxyl radicals"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00230> ;
.

goldbook:00231
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00231"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
