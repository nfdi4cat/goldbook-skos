    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00157.ttl> ;
    skos:definition "Chromatography in which separation is based mainly on differences between the adsorption affinities of the sample components for the surface of an active solid."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "adsorption chromatography"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00157> ;
.

