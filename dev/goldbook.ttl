goldbook:00513
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00513"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00513.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00513.ttl> ;
    skos:definition "Analogous to absorbance, but taking into account also the effects due to scattering and luminescence. It was formerly called extinction."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "attenuance"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00513> ;
.

goldbook:00543
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00543"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00543.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00543.ttl> ;
    skos:definition "The Avogadro constant, \\(N_{\\rm{A}} = \\pu{6.02214076E23 mol-1}\\), is a proportionality constant between the quantity amount of substance (\\(n\\), with unit mole) and the quantity for counting entities (\\(N\\) with unit one, symbol 1), \\(N = N_{\\rm{A}}\\ n\\)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "Avogadro constant"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00543> ;
.

goldbook:04811
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "04811"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-06"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs04xxx/04811.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs04xxx/04811.ttl> ;
    skos:altLabel
        "A-factor"@en ,
        "Arrhenius A factor"@en ;
    skos:definition "Coefficient in front of the exponential factor expressing the empirical temperature dependence of the rate coefficient, \\(k\\), on temperature, \\(T\\), \\(k=A\\ \\exp (- E_{\\rm{a}}/R\\ T)\\), where \\(E_{\\rm{a}}\\) is the activation energy."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "pre-exponential factor"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.P04811> ;
.

goldbook:06799
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "06799"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs06xxx/06799.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs06xxx/06799.ttl> ;
    skos:altLabel
        "ADI"@en ,
        "JECFA"@en ;
    skos:definition "Estimate by JECFA of the amount of a food additive, expressed on a body-weight basis, that can be ingested daily over a lifetime without appreciable health risk."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "acceptable daily intake"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.AT06799> ;
.

goldbook:07312
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "07312"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs07xxx/07312.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs07xxx/07312.ttl> ;
    skos:altLabel "absorbed spectral photon flux density"@en ;
    skos:definition "Number of photons of a particular wavelength per time interval (spectral photon flux, number basis, \\(q_{\\rm{p},\\lambda }\\), or spectral photon flux, amount basis, \\(q_{n,\\rm{p},\\lambda }\\)) absorbed by a system per volume, \\(V\\). On number basis, SI unit is \\(\\rm{s}^{-1}\\ \\rm{m}^{-4}\\), and the  common unit is \\(\\rm{s}^{-1}\\ \\rm{cm}^{-3}\\ \\rm{nm}^{-1}\\). On amount basis, SI unit is \\(\\pu{mol s-1 m-4}\\), and a common unit is \\(\\pu{einstein s-1 cm-3 nm-1}\\)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "absorbed photon flux density"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.AT07312> ;
.

goldbook:07313
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "07313"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs07xxx/07313.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs07xxx/07313.ttl> ;
    skos:altLabel "absorbed spectral radiant power density"@en ;
    skos:definition "Spectral radiant energy per time interval (spectral radiant power, \\(P_{\\lambda}\\)) absorbed by a system per volume, \\(V\\). SI unit is \\(\\rm{W m}^{-4}\\); common unit is \\(\\rm{W cm}^{-3}\\ \\rm{nm}^{-1}\\)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "absorbed radiant power density"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.AT07313> ;
.

