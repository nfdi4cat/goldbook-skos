    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs14xxx/14433.ttl> ;
    skos:definition "Any of various chiefly aquatic, eukaryotic, photosynthetic organisms, ranging in size from single-celled forms to the giant kelp."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alga"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.14433> ;
.

goldbook:14434
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "14434"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
