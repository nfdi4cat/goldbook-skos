    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00251.ttl> ;
    skos:definition "A copolymerization in which an alternating copolymer is formed."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alternating copolymerization"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00251> ;
.

goldbook:00252
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00252"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00252.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00252.ttl> ;
    skos:definition "Current with sinusoidal wave forms; all other wave forms should be termed 'periodic'."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alternating current"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00252> ;
.

goldbook:00254
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00254"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00254.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00254.ttl> ;
    skos:definition "This term should be applied only to sinusoidal phenomena; the term periodic voltage should be used for other wave forms."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alternating voltage"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00254> ;
.

goldbook:00256
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00256"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00256.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00256.ttl> ;
    skos:definition "A dappled layer of patch or cloud composed of flattened globules that may be arranged in groups, lines or waves collectively known as billows; \\(\\rm{2000–6000 m}\\); vertical velocities of \\(\\rm{0.05–0.1 m s}^{-1}\\)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "altocumulus cloud"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00256> ;
.

goldbook:00257
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00257"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00257.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00257.ttl> ;
    skos:definition "A grey, uniform, striated or fibrous sheet but without halo phenomena, and through which the sun is seen only as a diffuse, bright patch or not at all; usually at elevations \\(\\rm{2000–6000 m}\\); vertical velocities of \\(\\rm{0.05–0.1 m s}^{-1}\\)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "altostratus cloud"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00257> ;
.

goldbook:00258
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00258"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00258.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00258.ttl> ;
    skos:definition "A description applied to a chemical species whose molecular entities each possess two alternative and strongly interacting distinguishable reactive centres, to either of which a bond may be made in a reaction: the centres must be connected in such a way that reaction at either site stops or greatly retards subsequent attack at the second site. The term is most commonly applied to conjugated nucleophiles, for example the enolate ion:  (which may react with electrophiles either at the $\\ce{\\upbeta\\!\\mbox{-}carbon atom}$ or at oxygen) or $\\ce{\\upgamma\\!\\mbox{-}pyridones}$, and also to the vicinally ambident cyanide ion, cyanate ion, thiocyanate ion, sulfinate ion, nitrite ion and unsymmetrical hydrazines. Ambident electrophiles are exemplified by carboxylic esters $\\ce{RC(=O)OCR3}$ which react with nucleophiles either at the carbonyl carbon or the alkoxy carbon. Molecular entities, such as dianions of dicarboxylic acids, containing two non-interacting (or feebly interacting) reactive centres, are not generally considered to be ambident and are better described as 'bifunctional'. The Latin root of the word implies two reactive centres, but the term has in the past also incorrectly been applied to chemical species with more than two reactive centres. For such species the existing term 'polydent' (or, better, 'multident') is more appropriate."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "ambident"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00258> ;
.

goldbook:00259
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00259"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00259.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00259.ttl> ;
    skos:definition "The outdoor air in the particular location."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "ambient air"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00259> ;
.

goldbook:00261
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00261"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-06"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00261.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00261.ttl> ;
    skos:definition "A prefix used to indicate that a molecule with two (or more) chiral elements is present as a mixture of the two racemic diastereoisomers in unspecified proportions. For example, the dipeptide formed from ʟ-alanine and ᴅʟ-leucine is ʟ-alanyl-ambo-leucine."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "ambo"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00261> ;
.

goldbook:00262
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00262"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00262.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00262.ttl> ;
    skos:definition "A screening test employed in predicting the mutagenic and the potential carcinogenic activities of chemicals in the environment. It employs Ames test strains of salmonella bacteria ($\\ce{his^{-}}$) which lack the ability to produce histidine. The compound to be tested, the bacteria and a small amount of histidine (insufficient to permit colony growth but enough to allow sufficient growth for expression of mutations) are added to agar. The bacteria are allowed to incubate for about \\(63\\ \\rm{h}\\) at \\(37\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\). If a significant increase in colonies above background is observed in the sample containing the test compound, then it is concluded that the chemical tested is a direct mutagen for the particular Ames strain of bacteria. This is taken as a qualitative indication of the possible carcinogenic activity of this chemical in other biological systems. This procedure seems to be of qualitative value in a preliminary screening of potential carcinogens."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "Ames/salmonella test"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00262> ;
.

goldbook:00263
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00263"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00263.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00263.ttl> ;
    skos:definition "Carbamoyl carboxylic acids, i.e. compounds containing a carboxy and a carboxamide group, e.g. 5-carbamoylnicotinic acid."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amic acids"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00263> ;
.

goldbook:00265
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00265"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00265.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00265.ttl> ;
    skos:definition "Compounds having the structure $\\ce{RC(NH2)=NOH}$ and derivatives formed by substitution; formally the oximes of carboxamides."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amide oximes"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00265> ;
.

goldbook:00266
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00266"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00266.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00266.ttl> ;
    skos:definition "Derivatives of oxoacids $\\ce{R_{k}E(=O)_{l}(OH)_{m}}\\ (l \\neq 0)$ in which an acidic hydroxy group has been replaced by an amino or substituted amino group. Chalcogen replacement analogues are called thio-, seleno- and telluro-amides. Compounds having one, two or three acyl groups on a given nitrogen are generically included and may be designated as primary, secondary and tertiary amides, respectively, e.g.  benzamide, N,N-dimethylmethanesulfonamide,  secondary amides (see imides),  tertiary amides,  phenylphosphonamidic acid.Notes:Amides with $\\ce{NH2}$, $\\ce{NHR}$ and $\\ce{NR2}$ groups should not be distinguished by means of the terms primary, secondary and tertiary.Derivatives of certain acidic compounds $\\ce{R_{n}E(OH)_{m}}$, where $\\ce{E}$ is not carbon (e.g. sulfenic acids, $\\ce{RSOH}$, phosphinous acids, $\\ce{R2POH)}$, having the structure $\\ce{R_{n}E(NR2)_{m}}$ may be named as amides but do not belong to the class amides proper, e.g. $\\ce{CH3CH2SNH2}$ ethanesulfenamide or ethylsulfanylamine.The term applies also to metal derivatives of ammonia and amines, in which a cation replaces a hydrogen atom on nitrogen. Such compounds are also called azanides, e.g.  lithium diisopropylamide, synonym lithium diisopropylazanide.See also: carboxamides, lactams, peptides, phosphoramides, sulfonamides"@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amides"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00266> ;
.

goldbook:00267
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00267"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00267.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00267.ttl> ;
    skos:definition "Derivatives of oxoacids $\\ce{R_{n}E(=O)OH}$ in which the hydroxy group is replaced by an amino group and the oxo group is replaced by $\\ce{=NR}$. Amidines include carboxamidines, sulfinamidines and phosphinamidines, $\\ce{R2P(=NR)NR2}$. In organic chemistry an unspecified amidine is commonly a carboxamidine."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amidines"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00267> ;
.

goldbook:00268
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00268"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00268.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00268.ttl> ;
    skos:definition "Cations formally derived by the addition of one hydron to the $\\ce{N}$ or $\\ce{O}$ atom of an amide and $N$-hydrocarbyl derivatives thereof. In organic chemistry an unspecified amidium ion is commonly a carboxamidium ion  or  The term does not imply knowledge concerning the position of the cationic centre, e.g. $\\ce{PhC(=O)N^{+}Me3}$ N,N,N-trimethylbenzamidium."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amidium ions"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00268> ;
.

goldbook:00269
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00269"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00269.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00269.ttl> ;
    skos:definition "Compounds having the structure $\\ce{RC(=NH)NHNH2}$ or $\\ce{RC(NH2)=NNH2}$, formally derived from carboxylic acids. These tautomers are named hydrazide imides and amide hydrazones, respectively. Also included are $N$-hydrocarbyl derivatives."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amidrazones"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00269> ;
.

goldbook:00270
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00270"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00270.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00270.ttl> ;
    skos:definition "Compounds having two amino groups bonded to the same carbon, $\\ce{R2C(NR2)2}$. Also called geminal diamines. [The term aminal has also been used, with consequent ambiguity, for $\\ce{\\upalpha\\!\\mbox{-}amino}$ ethers (hemiaminal ethers); such use is discouraged.]"@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "aminals"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00270> ;
.

goldbook:00271
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00271"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00271.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00271.ttl> ;
    skos:definition "Compounds formally derived from the attachment of an amine $\\ce{R3N}$ to a nitrene $\\ce{RN{:}}$ . The structure $\\ce{R3N^{+}–N−R}$ expresses the 1,2-dipolar character of amine imides. They may be named systematically as substituted diazan-2-ium-1-ides, e.g. $\\ce{Me3N^{+}–N−Me}$, 1,2,2,2-tetramethyldiazan-2-ium-1-ide or trimethylamine $N$-methylimide."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amine imides"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00271> ;
.

goldbook:00273
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00273"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00273.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00273.ttl> ;
    skos:definition "Compounds derived from tertiary amines by the attachment of one oxygen atom to the nitrogen atom $\\ce{R3N^{+}–O^{−}}$. By extension the term includes the analogous derivatives of primary and secondary amines."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amine oxides"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00273> ;
.

goldbook:00274
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00274"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00274.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00274.ttl> ;
    skos:definition "Compounds formally derived from ammonia by replacing one, two or three hydrogen atoms by hydrocarbyl groups, and having the general structures $\\ce{RNH2}$ (primary amines), $\\ce{R2NH}$ (secondary amines), $\\ce{R3N}$ (tertiary amines)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amines"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00274> ;
.

goldbook:00275
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
