    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs07xxx/07318.ttl> ;
    skos:definition "Photochemical process leading to formation of a cyclobutane upon addition of an electronically excited alkene to another ground-state alkene or of an electronically excited $\\ce{\\upalpha\\!,\\upbeta\\!\\mbox{-}unsaturated}$ carbonyl compound to a ground-state alkene. The latter is called a de Mayo reaction."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alkene photocycloaddition"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.AT07318> ;
.

goldbook:07319
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "07319"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
