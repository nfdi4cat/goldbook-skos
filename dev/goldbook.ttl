    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00217.ttl> ;
    skos:definition "Acyclic or cyclic, saturated or unsaturated carbon compounds, excluding aromatic compounds."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "aliphatic compounds"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00217> ;
.

goldbook:00218
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00218"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00218.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00218.ttl> ;
    skos:definition "A known amount of a homogeneous material, assumed to be taken with negligible sampling error. The term is usually applied to fluids. The term 'aliquot' is usually used when the fractional part is an exact divisor of the whole; the term 'aliquant' has been used when the fractional part is not an exact divisor of the whole (e.g. a \\(15\\ \\rm{ml}\\) portion is an aliquant of \\(100\\ \\rm{ml}\\)). When a laboratory sample or test sample is 'aliquoted' or otherwise subdivided, the portions have been called split samples."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "aliquot"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00218> ;
.

goldbook:00220
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00220"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00220.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00220.ttl> ;
    skos:definition "Basic nitrogen compounds (mostly heterocyclic) occurring mostly in the plant kingdom (but not excluding those of animal origin). Amino acids, peptides, proteins, nucleotides, nucleic acids, amino sugars and antibiotics are not normally regarded as alkaloids. By extension, certain neutral compounds biogenetically related to basic alkaloids are included."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alkaloids"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00220> ;
.

goldbook:00221
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00221"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00221.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00221.ttl> ;
    skos:definition "Pathological condition in which the hydrogen ion substance concentration of body fluids is below normal and hence the pH of blood rises above the reference interval."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alkalosis"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00221> ;
.

goldbook:00222
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00222"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00222.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00222.ttl> ;
    skos:definition "Acyclic branched or unbranched hydrocarbons having the general formula $\\ce{C_{n}H_{2n+2}}$, and therefore consisting entirely of hydrogen atoms and saturated carbon atoms."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alkanes"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00222> ;
.

goldbook:00223
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00223"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00223.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00223.ttl> ;
    skos:definition "Carbocations derived from alkanes by $C$-hydronation containing at least one pentacoordinate carbon atom, e.g. $\\ce{^{+}CH5}$ methanium, $\\ce{[C2H7]^{+}$ ethanium."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alkanium ions"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00223> ;
.

goldbook:00224
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00224"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00224.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00224.ttl> ;
    skos:definition "Acyclic branched or unbranched hydrocarbons having one carbon–carbon double bond and the general formula $\\ce{C_{n}H_{2n}}$. Acyclic branched or unbranched hydrocarbons having more than one double bond are alkadienes, alkatrienes, etc."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alkenes"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00224> ;
.

goldbook:00225
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00225"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00225.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00225.ttl> ;
    skos:definition "Compounds, $\\ce{ROM}$, derivatives of alcohols, $\\ce{ROH}$, in which $\\ce{R}$ is saturated at the site of its attachment to oxygen and $\\ce{M}$ is a metal or other cationic species."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alkoxides"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00225> ;
.

goldbook:00226
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00226"^^xsd:token ;
