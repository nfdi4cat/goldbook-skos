    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00056.ttl> ;
    skos:altLabel "AN"@en ;
    skos:definition "A quantitative measure of Lewis acidity."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "acceptor number"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00056> ;
.

goldbook:00086
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00086"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00086.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00086.ttl> ;
    skos:definition "The quantity of light available to molecules at a particular point in the atmosphere and which, on absorption, drives photochemical processes in the atmosphere. It is calculated by integrating the spectral radiance \\(L \\left(\\lambda,\\,\\theta,\\,\\varphi\\,\\right)\\) over all directions of incidence of the light, \\(S_{\\lambda} = \\int _{\\theta}\\, \\int _{\\phi} \\{L\\left (\\lambda,\\theta,\\varphi \\right)/(hc/\\lambda)\\}\\, \\rm{sin}\\,\\theta\\: \\rm{d}\\theta\\: \\rm{d}\\varphi\\). If the radiance is expressed in \\(\\pu{J m-2 s-1 st-1 nm-1}\\) and \\(hc/\\lambda\\) is the energy per quantum of light of wavelength \\(\\lambda\\), the actinic flux has units of \\(\\rm{quanta cm}^{-2}\\ \\rm{s}^{-1}\\ \\rm{nm}^{-1}\\). This important quantity is one of the terms required in the calculation of j-values, the first order rate coefficients for photochemical processes in the sunlight-absorbing, trace gases in the atmosphere. The actinic flux is determined by the solar radiation entering the atmosphere and by any changes in this due to atmospheric gases and particles (e.g. Rayleigh scattering absorption by stratospheric ozone, scattering and absorption by aerosols and clouds), and reflections from the ground. It is therefore dependent on the wavelength of the light, on the altitude and on specific local environmental conditions. The actinic flux has borne many names (e.g. flux, flux density, beam irradiance, actinic irradiance, integrated intensity) which has caused some confusion. It is important to distinguish the actinic flux from the spectral irradiance, which refers to energy arrival on a flat surface having fixed spatial orientation (\\(\\pu{J m-2 nm-1}\\)) given by: \\[E_{\\lambda} = \\int _{\\theta}\\, \\int _{\\phi} L\\left (\\lambda,\\theta,\\varphi \\right )\\, \\rm{cos}\\,\\theta  \\: \\rm{sin}\\,\\theta\\: \\rm{d}\\theta\\: \\rm{d}\\varphi\\] The actinic flux does not refer to any specific orientation because molecules are oriented randomly in the atmosphere. This distinction is of practical relevance: the actinic flux (and therefore a j-value) near a brightly reflecting surface (e.g. over snow or above a thick cloud) can be a factor of three higher than that near a non-reflecting surface. The more descriptive name of spectral spheradiance is suggested for the quantity herein called actinic flux."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "actinic flux"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00086> ;
.

goldbook:00114
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00114"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00114.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00114.ttl> ;
    skos:altLabel
        "decay rate"@en ,
        "disintegration rate"@en ;
    skos:definition "The number of nuclear decays occurring in a given quantity of material in a small time interval, divided by that time interval. Often, this term is referred to as absolute activity. Symbol \\(A=- \\frac{\\mathrm{d}N}{\\mathrm{d}t}\\). Synonymous with disintegration rate or decay rate."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "activity"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00114> ;
.

goldbook:00115
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00115"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00115.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00115.ttl> ;
    skos:altLabel "relative activity"@en ;
    skos:definition "Defined by the equation \\[a = e^{\\frac{\\mu - \\mu^{o}}{R\\,T}}\\] where \\(R\\) is the gas constant, \\(T\\) the thermodynamic temperature, \\(\\mu\\) the chemical potential and \\(\\mu^{o}\\) the standard chemical potential the definition of which depends on the choice of the standard state."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "activity"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00115> ;
.

goldbook:00116
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00116"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00116.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00116.ttl> ;
    skos:definition "The activity coefficient \\(f_{\\rm{B}}\\) of a substance B in a liquid or solid mixture containing mole fractions \\(x_{\\rm{B}}\\), \\(x_{\\rm{C}}\\), ... of the substances B, C, ... is a dimensionless quantity defined in terms of the chemical potential \\(\\mu _{\\rm{B}}\\) of B in the mixture by: \\[R T \\ln (x_{\\ce{B}} f_{\\ce{B}}) = \\mu_{\\ce{B}}({\\ce{cd}},T,P,x) - \\mu_{\\ce{B}}^{\\ast}({\\ce{cd}},T,p)\\] where \\(x\\) denotes the set of mole fractions \\(x_{\\rm{B}}\\), \\(x_{\\rm{C}}\\), ... . The activity coefficient \\(\\gamma _{\\rm{B}}\\) of a solute B in a solution (especially a dilute liquid solution) containing molalities \\(m_{\\rm{B}}\\), \\(m_{\\rm{C}}\\), ... of solutes B, C, ... in a solvent A is a dimensionless quantity defined in terms of the chemical potential \\(\\mu _{\\rm{B}}\\) by: \\[R\\ T\\ \\ln \\left(\\frac{m_{\\rm{B}}\\ \\gamma _{\\rm{B}}}{m^{\\ominus}}\\right)=\\mu _{\\rm{B}}- \\left\\{\\mu _{\\rm{B}}- R\\ T\\ \\ln \\left(\\frac{m_{\\rm{B}}}{m^{\\ominus }}\\right)\\right\\}^{\\infty }\\]"@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "activity coefficient"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00116> ;
.

goldbook:00178
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00178"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00178.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00178.ttl> ;
    skos:definition "Negative partial derivative of Gibbs energy with respect to extent of reaction at constant pressure and temperature. It is positive for spontaneous reactions."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "affinity of reaction"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00178> ;
.

goldbook:00295
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00295"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00295.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00295.ttl> ;
    skos:definition "Amount of a constituent divided by the volume of the mixture. Also called amount-of-substance concentration, substance concentration (in clinical chemistry) and in older literature molarity. For entities B it is often denoted by \\(\\left[\\rm{B}\\right]\\). The common unit is mole per cubic decimetre (\\(\\pu{mol dm-3}\\)) or mole per litre (\\(\\pu{mol L-1}\\)) sometimes denoted by \\(M\\)."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amount concentration"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00295> ;
.

goldbook:00296
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00296"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00296.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00296.ttl> ;
    skos:altLabel "mole fraction"@en ;
    skos:definition "Amount of a constituent divided by the total amount of all constituents in the mixture. It is also called mole fraction. Amount fraction is equal to the 'number fraction': the number of entities of one constituent divided by the total number of entities in the mixture."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amount fraction"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00296> ;
.

goldbook:00297
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00297"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00297.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00297.ttl> ;
    skos:altLabel "chemical amount"@en ;
    skos:definition "The amount of substance, symbol \\(n\\), of a system is a measure of the number of specified elementary entities. An elementary entity may be an atom, a molecule, an ion, an electron, any other particle or specified group of particles."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amount of substance"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00297> ;
.

goldbook:00300
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00300"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00300.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00300.ttl> ;
    skos:definition "The ampere, symbol \\(\\rm{A}\\), is the SI unit of electric current. It is defined by taking the fixed numerical value of the elementary charge \\(e\\) to be \\(1.602\\ 176\\ 634\\times10^{-19}\\) when expressed in the unit \\(\\rm{C}\\), which is equal to \\(\\rm{A s}\\), where the second is defined in terms of ΔνCs."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "ampere"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00300> ;
.

goldbook:00346
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00346"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00346.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00346.ttl> ;
    skos:altLabel "plane angle"@en ;
    skos:definition "The angle between two half-lines terminating at the same point is the ratio of the length of the included arc of the circle (with its centre at that point) to the radius of the circle. Symbols: \\(\\alpha \\), \\(\\beta \\), \\(\\gamma \\) ... This is a quantity of dimension one with the SI unit radian (\\(\\pu{rad}\\)), but very often degrees of arc are used."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "angle"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00346> ;
.

goldbook:00348
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00348"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00348.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00348.ttl> ;
    skos:definition "Angle through which plane polarized light is rotated clockwise, as seen when facing the light source, in passing through an optically active medium."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "angle of optical rotation"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00348> ;
.

goldbook:00352
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00352"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
