    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00496.ttl> ;
    skos:definition "Rest mass of an atom in its ground state. The commonly used unit is the unified atomic mass unit."@en ;
