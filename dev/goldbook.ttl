    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00231.ttl> ;
    skos:definition "Radicals having the structure $\\ce{R2C=N^{.}}$. Synonymous with iminyl radicals."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alkylideneaminyl radicals"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00231> ;
.

goldbook:00232
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00232"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00232.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00232.ttl> ;
    skos:definition "The divalent groups formed from alkanes by removal of two hydrogen atoms from the same carbon atom, the free valencies of which are part of a double bond, e.g. $\\ce{(CH3)2C=}$ propan-2-ylidene."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alkylidene groups"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00232> ;
.

goldbook:00233
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00233"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00233.ttl> ;
