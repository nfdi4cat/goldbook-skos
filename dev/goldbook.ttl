    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00154.ttl> ;
    skos:definition "Solid material used to capture either a gas or liquid; often activated carbon is employed as the solid because of its high surface area per unit mass."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "adsorber"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00154> ;
