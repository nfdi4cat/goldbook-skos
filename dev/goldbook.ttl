    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00379.ttl> ;
    skos:definition "Aglycons of anthocyanins; they are oxygenated derivatives of flavylium (2-phenylchromenylium) salts."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "anthocyanidins"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00379> ;
.

goldbook:00380
    a skos:Concept ;
