goldbook:00215
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00215"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00215.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00215.ttl> ;
    skos:definition "Designated concentrations of certain key pollutants at which some degree of danger to public health is expected. In many areas in which a relatively high level of pollution is often encountered, several levels of alert are often established. For example, a first alert may signify a potential problem exists; a second alert becomes a signal for the curtailment of certain significant emission sources; the third alert signifies the need for some specified emergency action which must be taken to ensure the public safety."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alert levels"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00215> ;
.

goldbook:00216
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00216"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00216.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00216.ttl> ;
    skos:definition "Aliphatic compounds having a carbocyclic ring structure which may be saturated or unsaturated, but may not be a benzenoid or other aromatic system."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "alicyclic compounds"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00216> ;
.

goldbook:00217
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00217"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
