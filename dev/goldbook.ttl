    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00482.ttl> ;
    skos:definition "A film bounded by two different bulk phases. When the bulk phases are identical the film is described as symmetric."@en ;
