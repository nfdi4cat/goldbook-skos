    skos:definition "Polyhydroxy dicarboxylic acids having the general formula $\\ce{HOC(=O)[CH(OH)]_{n}C(=O)OH}$, formally derived from an aldose by oxidation of both terminal carbon atoms to carboxyl groups."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "aldaric acids"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00206> ;
