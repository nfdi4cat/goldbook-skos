goldbook:12219
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "12219"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs12xxx/12219.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs12xxx/12219.ttl> ;
    skos:definition """The equation for (z + 1)-average molar mass is \\[M_{\\rm{z+1}} = \\frac{\\sum\\limits_{M} w_{M}M^{3}}{\\sum\\limits_M w_{M}M^{2}}\\]
The equation for (z + 1)-average molecular weight is \\[M_{\\rm{r,z+1}} = \\frac{\\sum\\limits_{M_{\\rm{r}}} w_{M_{\\rm{r}}}M^{3}}{\\sum\\limits_{M_{\\rm{r}}} w_{M_{\\rm{r}}}M^{2}}\\]"""@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "(z + 1)-average molar mass"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.12219> ;
.
