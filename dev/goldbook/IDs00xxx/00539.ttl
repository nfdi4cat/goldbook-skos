    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00539.ttl> ;
    skos:definition "The average current density, \\(j\\), is defined by \\[j = A^{-1}\\ \\int _{A}j_{x}\\ \\rm{d}A\\] where \\(A\\) is the electrode area, \\(j_{x}\\) is the local current density and \\(\\rm{d}A\\) is an infinitesimal surface element."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "average current density"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00539> ;
.
