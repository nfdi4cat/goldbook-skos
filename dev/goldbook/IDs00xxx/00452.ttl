    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00452.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00452.ttl> ;
    skos:definition "AsH3 and compounds derived from it by substituting one, two or three hydrogen atoms by hydrocarbyl groups: $\\ce{R3As}$, $\\ce{RAsH2}$, $\\ce{R2AsH}$, $\\ce{R3As}$ ($\\ce{R} \\neq \\ce{H}$) are called primary, secondary and tertiary arsines, respectively. A specific arsine is preferably named as a substituted arsane, e.g. $\\ce{CH3CH2AsH2}$ ethylarsane."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "arsines"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00452> ;
.
