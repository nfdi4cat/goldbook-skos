    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00421.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00421.ttl> ;
    skos:altLabel "appearance potential"@en ;
    skos:definition "Refers to ionization of a molecule or atom by electron collision or photon absorption. In mass spectrometry it has often been reported as the voltage which corresponds to the minimum energy of the electrons in the ionizing beam necessary for the production of a given fragment ion. In photoionization it is the minimum energy of the quantum of light which produces ionization of the absorbing molecule."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "appearance energy"@en ;
