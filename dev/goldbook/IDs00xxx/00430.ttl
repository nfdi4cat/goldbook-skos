goldbook:00430
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00430"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00430.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00430.ttl> ;
    skos:definition "In all measurements it is desirable that quantities like the charge and the capacity be related to unit, true, surface area of the interface. While this is relatively simple for a liquid-liquid interface, there are great difficulties when one phase is solid. In any report of these quantities it is essential to give a clear statement as to whether they refer to the true or the apparent (geometric) area and, especially if the former is used, precisely how it was measured."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "area of interface"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00430> ;
.
