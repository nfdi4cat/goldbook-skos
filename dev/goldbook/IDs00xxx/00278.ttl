    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00278.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00278.ttl> ;
    skos:definition "Radicals cations, $\\ce{R3N^{.+}}$, derivable from aminium ions, $\\ce{R3NH^{+}}$, by removal of a hydrogen atom. Aminiumyl radical ions are, except for $\\ce{H3N^{.+}}$, synonymous with the ammoniumyl radical ions. As the term ammonium is well known, ammoniumyl radical ions is the more desirable class name."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "aminiumyl radical ions"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00278> ;
.
