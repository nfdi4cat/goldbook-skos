goldbook:00519
    a skos:Concept ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:identifier "00519"^^xsd:token ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:provenance <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00519.ttl> ;
    dcterms:rightsHolder "International Union of Pure and Applied Chemistry (IUPAC)" ;
    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs00xxx/00519.ttl> ;
    skos:altLabel "early-downhill surface"@en ;
    skos:definition "A potential-energy surface for a process A + B–C in which the initial descent of the system into the product valley is associated with a substantial decrease in the A–B distance and with little separation between the products A–B and C. In terms of a potential-energy profile, the energy barrier occurs in the early stage of the reaction path. Attractive surfaces are also called early-downhill surfaces, and the barrier in such a surface is called a Type-I barrier."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "attractive potential-energy surface"@en ;
    skos:topConceptOf goldbook: ;
    prov:hadPrimarySource <https://doi.org/10.1351/goldbook.A00519> ;
.
