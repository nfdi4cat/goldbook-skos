    rdfs:seeAlso <https://github.com/nfdi4cat/goldbook-skos/blame/main/vocabularies/goldbook/IDs07xxx/07326.ttl> ;
    skos:definition "Intense source of ultraviolet (\\(185\\) and \\(253.7\\ \\rm{nm}\\)) radiation produced by an electrical discharge in a lamp with the inner side covered by an amalgam of mercury with another element such as indium or gallium to control the vapour pressure of the mercury. These lamp have 2-3 times the UV output for the same wavelength as the standard low-pressure mercury lamp."@en ;
    skos:inScheme goldbook: ;
    skos:prefLabel "amalgam lamp"@en ;
    skos:topConceptOf goldbook: ;
